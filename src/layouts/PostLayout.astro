---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  pubDate: Date;
  tags?: string[];
  description?: string;
  categoryName: string;
}

const { title, pubDate, tags, description, categoryName } = Astro.props;
---

<BaseLayout title={title}>
  <article class="article-wrap">
    <header class="article-header">
      <div class="article-category">{categoryName}</div>
      <h1 class="article-title">{title}</h1>
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {tags && tags.length > 0 && (
          <span> · {tags.join(' · ')}</span>
        )}
      </div>
      {description && <p class="article-description">{description}</p>}
    </header>
    <div class="article-body">
      <slot />
    </div>
  </article>
</BaseLayout>
