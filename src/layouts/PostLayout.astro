---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  pubDate: Date;
  tags?: string[];
  description?: string;
  image?: string;
  categoryName: string;
  backHref?: string;
  backLabel?: string;
}

const { title, pubDate, tags, description, image, categoryName, backHref, backLabel } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} type="article" pubDate={pubDate}>
  <div class="read-progress" data-read-progress aria-hidden="true"></div>
  <article class="article-wrap">
    {backHref && (
      <a href={backHref} class="back-link">← 返回<span> {backLabel || '上一级'}</span></a>
    )}
    <header class="article-header">
      <div class="article-category">{categoryName}</div>
      <h1 class="article-title">{title}</h1>
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {tags && tags.length > 0 && (
          <span> · {tags.join(' · ')}</span>
        )}
      </div>
      {description && <p class="article-description">{description}</p>}
    </header>
    <div class="article-body">
      <slot />
    </div>
  </article>

<script>
  // 阅读进度条：文章页顶部一条 2px 的线，宽度＝滚动进度。
  // 用 rAF 节流，滚动事件本身不做事；View Transitions 换页后靠 astro:page-load 重新计算。
  let raf = 0;
  function updateProgress() {
    raf = 0;
    const bar = document.querySelector('[data-read-progress]');
    if (!bar) return; // 非文章页直接跳过
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, doc.scrollTop / max)) : 0;
    bar.style.setProperty('--p', p.toFixed(4));
  }
  function onScroll() {
    if (!raf) raf = requestAnimationFrame(updateProgress);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  document.addEventListener('astro:page-load', updateProgress);
  updateProgress();
</script>
</BaseLayout>

