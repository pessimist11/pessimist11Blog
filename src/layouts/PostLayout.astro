---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  pubDate: Date;
  tags?: string[];
  description?: string;
  image?: string;
  categoryName: string;
  backHref?: string;
  backLabel?: string;
}

const { title, pubDate, tags, description, image, categoryName, backHref, backLabel } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} type="article">
  <article class="article-wrap">
    {backHref && (
      <a href={backHref} class="back-link">← 返回<span> {backLabel || '上一级'}</span></a>
    )}
    <header class="article-header">
      <div class="article-category">{categoryName}</div>
      <h1 class="article-title">{title}</h1>
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {tags && tags.length > 0 && (
          <span> · {tags.join(' · ')}</span>
        )}
      </div>
      {description && <p class="article-description">{description}</p>}
    </header>
    <div class="article-body">
      <slot />
    </div>
  </article>
</BaseLayout>
