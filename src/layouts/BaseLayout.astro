---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
  pageTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, image, type = 'website' } = Astro.props;

const defaultDescription = '记录无意义的生命中可能有意义的瞬间';
const ogDescription = description || defaultDescription;
const pageTitle = `${title} — pessimist11`;
const siteUrl = Astro.site ?? new URL('https://pessimist11.pages.dev');
const ogUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = image ? new URL(image, siteUrl).toString() : undefined;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // 进页面前定主题，避免闪色：localStorage 优先，其次跟随系统
      (() => {
        const KEY = 'theme';

        function storedTheme() {
          try {
            const t = localStorage.getItem(KEY);
            return t === 'light' || t === 'dark' ? t : null;
          } catch {
            return null;
          }
        }

        function systemTheme() {
          return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function applyTheme() {
          const t = storedTheme() || systemTheme();
          document.documentElement.dataset.theme = t;
          const toggle = document.getElementById('themeToggle');
          if (toggle) toggle.textContent = t === 'dark' ? '●' : '○';
        }

        applyTheme();

        // 切换按钮：事件委托，View Transitions 换页后依然可用
        document.addEventListener('click', (e) => {
          const toggle = e.target.closest('#themeToggle');
          if (!toggle) return;
          const isDark = document.documentElement.dataset.theme === 'dark';
          const next = isDark ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          toggle.textContent = next === 'dark' ? '●' : '○';
          try {
            localStorage.setItem(KEY, next);
          } catch {}
        });

        // View Transitions 换页后 html 会被替换，需重新应用主题
        document.addEventListener('astro:page-load', applyTheme);

        // 未手动选择过主题时，跟随系统实时切换
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
          if (!storedTheme()) applyTheme();
        });
      })();
    </script>
    <ClientRouter />
    <meta name="description" content={ogDescription} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="pessimist11" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="pessimist11" />
    <meta property="og:locale" content="zh_CN" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body>
    <div class="watermark" aria-hidden="true">pessimist11</div>
    <nav>
      <div class="nav-inner">
        <a href="/" class="nav-title">pessimist11</a>
        <div class="nav-links">
          <a href="/zhi/">知</a>
          <a href="/si/">思</a>
          <a href="/zhen/">帧</a>
          <a href="/fu/">馥</a>
          <a href="/about/">关于</a>
          <button class="theme-toggle" id="themeToggle" aria-label="切换主题">○</button>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-left">
          &copy; {new Date().getFullYear()} pessimist11
        </div>
        <div class="footer-right">
          <a href="https://github.com/pessimist11" target="_blank" rel="noopener">GitHub</a>
          <span class="footer-sep">·</span>
          <a href="/rss.xml">RSS</a>
          <span class="footer-sep">·</span>
          <a href="mailto:icecode19@gmail.com">Email</a>
        </div>
      </div>
    </footer>

    <div class="lightbox" id="lightbox">
      <button class="lightbox-nav lightbox-prev" id="lightboxPrev">‹</button>
      <img src="" alt="" id="lightboxImg" />
      <button class="lightbox-nav lightbox-next" id="lightboxNext">›</button>
    </div>

    <script>
      // Scroll reveal —— astro:page-load 保证 View Transitions 换页后重新观察
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

      function initReveal() {
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
      }
      document.addEventListener('astro:page-load', initReveal);
      initReveal();

      // Lightbox —— 全部事件委托 + 实时取元素，View Transitions 换页后依然可用
      let lightboxImages = [];
      let currentIndex = -1;

      function lightboxEl() { return document.getElementById('lightbox'); }
      function lightboxImgEl() { return document.getElementById('lightboxImg'); }
      function lightboxPrevEl() { return document.getElementById('lightboxPrev'); }
      function lightboxNextEl() { return document.getElementById('lightboxNext'); }

      function updateNavButtons() {
        const prev = lightboxPrevEl();
        const next = lightboxNextEl();
        if (prev) prev.style.display = currentIndex > 0 ? '' : 'none';
        if (next) next.style.display = currentIndex < lightboxImages.length - 1 ? '' : 'none';
      }

      function navigateLightbox(dir) {
        const next = currentIndex + dir;
        if (next >= 0 && next < lightboxImages.length) {
          currentIndex = next;
          const img = lightboxImgEl();
          if (img) img.src = lightboxImages[currentIndex];
          updateNavButtons();
        }
      }

      function openLightbox(src, imagesArray) {
        const box = lightboxEl();
        if (!box) return;
        lightboxImages = imagesArray || [src];
        currentIndex = lightboxImages.indexOf(src);
        if (currentIndex === -1) currentIndex = 0;
        const img = lightboxImgEl();
        if (img) img.src = lightboxImages[currentIndex];
        box.classList.add('open');
        updateNavButtons();
      }

      function closeLightbox() {
        const box = lightboxEl();
        if (!box) return;
        box.classList.remove('open');
        const img = lightboxImgEl();
        if (img) img.src = '';
        lightboxImages = [];
        currentIndex = -1;
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') navigateLightbox(-1);
        if (e.key === 'ArrowRight') navigateLightbox(1);
      });

      function gatherImages(container) {
        if (!container) return [];
        return Array.from(container.querySelectorAll('img')).map(img => img.src);
      }

      document.addEventListener('click', (e) => {
        if (e.target.closest('#lightboxPrev')) {
          e.stopPropagation();
          navigateLightbox(-1);
          return;
        }
        if (e.target.closest('#lightboxNext')) {
          e.stopPropagation();
          navigateLightbox(1);
          return;
        }
        if (e.target.id === 'lightbox') {
          closeLightbox();
          return;
        }
        // 点击 帧 照片墙 / 图片网格 打开 lightbox
        const link = e.target.closest('.zhen-wall-item, .photo-grid-item');
        const hero = e.target.closest('.feature-photo-inner');
        if (link || hero) {
          const wrap = link || hero;
          const img = wrap.tagName === 'IMG' ? wrap : wrap.querySelector('img');
          if (img && img.src) {
            e.preventDefault();
            const container = wrap.closest('.zhen-wall') || wrap.closest('.photo-grid');
            openLightbox(img.src, container ? gatherImages(container) : null);
          }
        }
        // 点击文章正文里的图片
        if (e.target.tagName === 'IMG' && e.target.closest('.article-wrap')) {
          e.preventDefault();
          const article = e.target.closest('.article-wrap');
          openLightbox(e.target.src, gatherImages(article));
        }
      });
    </script>
  </body>
</html>
