---
import '@/styles/global.css';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { ClientRouter } from 'astro:transitions';
import { readFileSync } from 'node:fs';

// 字体子集由 scripts/build-fonts.mjs 生成到 public/fonts/（已 gitignore，每次构建重建）。
// 这里构建时读入并内联，省掉一次额外请求；文件缺失时优雅降级（只是没有 @font-face）。
let fontCss = '';
let fontPreload: string[] = [];
try {
  const dir = new URL('../../public/fonts/', import.meta.url);
  fontCss = readFileSync(new URL('fonts.css', dir), 'utf8');
  fontPreload = JSON.parse(readFileSync(new URL('manifest.json', dir), 'utf8')).preload ?? [];
} catch {
  console.warn('[BaseLayout] 未找到 public/fonts/，先运行 npm run fonts');
}

export interface Props {
  title: string;
  pageTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  immersiveHeader?: boolean;
}

const { title, pageTitle: customPageTitle, description, image, type = 'website', pubDate, immersiveHeader = false } = Astro.props;

const siteName = 'pessimist11';
const siteUrl = Astro.site ?? new URL('https://pessimist11.pages.dev');
const authorName = 'pessimist11 (saki)';
const githubUrl = 'https://github.com/pessimist11';
const defaultDescription = '记录无意义的生命中可能有意义的瞬间';
const ogDescription = description || defaultDescription;
const pageTitle = customPageTitle ?? `${title} — ${siteName}`;
const ogUrl = new URL(Astro.url.pathname, siteUrl).toString();
const canonical = ogUrl;
const defaultOg = new URL('/og.jpg', siteUrl).toString();
const ogImage = image ? new URL(image, siteUrl).toString() : defaultOg;
const isDefaultOg = !image;

const graph: any[] = [
  {
    '@type': 'Person',
    '@id': `${siteUrl}#person`,
    name: authorName,
    url: siteUrl,
    image: defaultOg,
    description: defaultDescription,
    knowsAbout: ['技术', '摄影', '随笔', '香水', '音乐'],
    sameAs: [githubUrl],
  },
  {
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    url: siteUrl,
    name: siteName,
    description: defaultDescription,
    inLanguage: 'zh-CN',
    publisher: { '@id': `${siteUrl}#person` },
  },
];
if (type === 'article') {
  graph.push({
    '@type': 'BlogPosting',
    headline: title,
    description: ogDescription,
    url: canonical,
    image: ogImage,
    datePublished: pubDate?.toISOString(),
    inLanguage: 'zh-CN',
    author: { '@type': 'Person', name: authorName, url: siteUrl },
    publisher: { '@id': `${siteUrl}#person` },
    mainEntityOfPage: canonical,
  });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // 标记 JS 可用：入场动效的初始 opacity:0 只在 .js 下生效。
      // 这样 JS 被禁用或脚本加载失败时，内容不会永远停在不可见状态。
      document.documentElement.classList.add('js');
    </script>
    <script is:inline>
      // 进页面前定主题，避免闪色：localStorage 优先，其次跟随系统
      (() => {
        const KEY = 'theme';

        function storedTheme() {
          try {
            const t = localStorage.getItem(KEY);
            return t === 'light' || t === 'dark' ? t : null;
          } catch {
            return null;
          }
        }

        function systemTheme() {
          return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function syncToggle(toggle, theme) {
          const label = theme === 'dark' ? '切换为浅色主题' : '切换为深色主题';
          toggle.setAttribute('aria-label', label);
          toggle.setAttribute('aria-pressed', String(theme === 'dark'));
          toggle.title = label;
        }

        function applyTheme() {
          const t = storedTheme() || systemTheme();
          document.documentElement.dataset.theme = t;
          const toggle = document.getElementById('themeToggle');
          if (toggle) syncToggle(toggle, t);
        }

        applyTheme();

        // 切换按钮：事件委托，View Transitions 换页后依然可用
        document.addEventListener('click', (e) => {
          const toggle = e.target instanceof Element ? e.target.closest('#themeToggle') : null;
          if (!toggle) return;
          const isDark = document.documentElement.dataset.theme === 'dark';
          const next = isDark ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          syncToggle(toggle, next);
          try {
            localStorage.setItem(KEY, next);
          } catch {}
        });

        // View Transitions 换页后 html 会被替换，需重新应用主题
        document.addEventListener('astro:page-load', applyTheme);
        document.addEventListener('astro:before-swap', (event) => {
          event.newDocument.documentElement.classList.add('js');
          event.newDocument.documentElement.dataset.theme = storedTheme() || systemTheme();
        });

        // 未手动选择过主题时，跟随系统实时切换
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
          if (!storedTheme()) applyTheme();
        });
      })();
    </script>
    <ClientRouter />
    <slot name="head" />
    <style is:inline set:html={fontCss}></style>
    {fontPreload.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <meta name="description" content={ogDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={jsonLd} />
    <title>{pageTitle}</title>
    <!-- 站点图标：圆角正方形的处理见 public/ 下各文件；apple-touch-icon 必须是
         方形不透明（iOS 自己加圆角，且会把透明处填黑） -->
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="pessimist11" href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="pessimist11" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImage} />
    {isDefaultOg && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body>
    <nav data-home-nav={immersiveHeader || undefined}>
      <div class="nav-inner">
        <a href="/" class="nav-title">pessimist11</a>
        <div class="nav-links">
          <a href="/zhi/">知</a>
          <a href="/si/">思</a>
          <a href="/zhen/">帧</a>
          <a href="/fu/">馥</a>
          <a href="/ling/">聆</a>
          <a href="/works/">作</a>
          <a href="/about/">关于</a>
          <ThemeToggle />
        </div>
      </div>
    </nav>

    <main class:list={{ 'main--immersive': immersiveHeader }}>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-left">
          &copy; {new Date().getFullYear()} pessimist11
        </div>
        <div class="footer-right">
          <a href="https://github.com/pessimist11" target="_blank" rel="noopener">GitHub</a>
          <span class="footer-sep">·</span>
          <a href="/rss.xml">RSS</a>
          <span class="footer-sep">·</span>
          <a href="mailto:icecode19@gmail.com">Email</a>
        </div>
      </div>
    </footer>

    <div class="lightbox" id="lightbox">
      <button class="lightbox-nav lightbox-prev" id="lightboxPrev">‹</button>
      <img src="" alt="" id="lightboxImg" />
      <button class="lightbox-nav lightbox-next" id="lightboxNext">›</button>
    </div>

    <script>
      // Scroll reveal —— astro:page-load 保证 View Transitions 换页后重新观察
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

      function initReveal() {
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
      }
      document.addEventListener('astro:page-load', initReveal);
      initReveal();

      // Lightbox —— 全部事件委托 + 实时取元素，View Transitions 换页后依然可用
      let lightboxImages = [];
      let currentIndex = -1;

      function lightboxEl() { return document.getElementById('lightbox'); }
      function lightboxImgEl() { return document.getElementById('lightboxImg'); }
      function lightboxPrevEl() { return document.getElementById('lightboxPrev'); }
      function lightboxNextEl() { return document.getElementById('lightboxNext'); }

      function updateNavButtons() {
        const prev = lightboxPrevEl();
        const next = lightboxNextEl();
        if (prev) prev.style.display = currentIndex > 0 ? '' : 'none';
        if (next) next.style.display = currentIndex < lightboxImages.length - 1 ? '' : 'none';
      }

      function navigateLightbox(dir) {
        const next = currentIndex + dir;
        if (next >= 0 && next < lightboxImages.length) {
          currentIndex = next;
          const img = lightboxImgEl();
          if (img) img.src = lightboxImages[currentIndex];
          updateNavButtons();
        }
      }

      function openLightbox(src, imagesArray) {
        const box = lightboxEl();
        if (!box) return;
        lightboxImages = imagesArray || [src];
        currentIndex = lightboxImages.indexOf(src);
        if (currentIndex === -1) currentIndex = 0;
        const img = lightboxImgEl();
        if (img) img.src = lightboxImages[currentIndex];
        box.classList.add('open');
        updateNavButtons();
      }

      function closeLightbox() {
        const box = lightboxEl();
        if (!box) return;
        box.classList.remove('open');
        const img = lightboxImgEl();
        if (img) img.src = '';
        lightboxImages = [];
        currentIndex = -1;
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') navigateLightbox(-1);
        if (e.key === 'ArrowRight') navigateLightbox(1);
      });

      // Lightbox 使用 srcset 中最大的一档，保证放大查看时的清晰度
      function bestSrc(img) {
        if (img && img.srcset) {
          const entries = img.srcset.split(',');
          const last = entries[entries.length - 1].trim();
          const url = last.split(/\s+/)[0];
          if (url) return url;
        }
        return img ? img.src : '';
      }

      function gatherImages(container) {
        if (!container) return [];
        return Array.from(container.querySelectorAll('img')).map(img => bestSrc(img));
      }

      document.addEventListener('click', (e) => {
        if (e.target.closest('#lightboxPrev')) {
          e.stopPropagation();
          navigateLightbox(-1);
          return;
        }
        if (e.target.closest('#lightboxNext')) {
          e.stopPropagation();
          navigateLightbox(1);
          return;
        }
        if (e.target.id === 'lightbox') {
          closeLightbox();
          return;
        }
        // 点击 帧 照片墙 / 图片网格 打开 lightbox
        const link = e.target.closest('.zhen-wall-item, .photo-grid-item');
        const hero = e.target.closest('.feature-photo-inner');
        if (link || hero) {
          const wrap = link || hero;
          const img = wrap.tagName === 'IMG' ? wrap : wrap.querySelector('img');
          if (img && img.src) {
            e.preventDefault();
            const container = wrap.closest('.zhen-wall') || wrap.closest('.photo-grid');
            openLightbox(bestSrc(img), container ? gatherImages(container) : null);
          }
        }
        // 点击文章正文里的图片
        if (e.target.tagName === 'IMG' && e.target.closest('.article-wrap')) {
          e.preventDefault();
          const article = e.target.closest('.article-wrap');
          openLightbox(bestSrc(e.target), gatherImages(article));
        }
      });
    </script>
  </body>
</html>
