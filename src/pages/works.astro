---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import homePreview from '@/assets/works/site-home.jpg';
import atlasPreview from '@/assets/works/site-atlas.jpg';
import galleryPreview from '@/assets/works/site-gallery.jpg';

const repository = 'https://github.com/pessimist11/pessimist11Blog';
---

<BaseLayout title="WORKS" description="pessimist11 个人网站的设计与实现：月亮首页、行旅地图与摄影相册。">
  <div class="page-wrap">
    <div class="page-heading reveal">
      <div class="page-heading-en">Works</div>
      <h1 class="page-heading-zh">作</h1>
    </div>
    <p class="works-intro reveal">从想法到实现，记录已经可以访问的作品。</p>

    <article class="project" aria-labelledby="project-title">
      <header class="project-header reveal">
        <div class="project-kicker"><span>01 / 个人网站</span><span class="project-status">已上线</span></div>
        <h2 id="project-title" class="project-title">pessimist11</h2>
        <p class="project-subtitle">文字、影像、气味与音乐的个人档案</p>
        <p class="project-description">把技术笔记、生活随想、旅行摄影、气味记忆与喜欢的音乐放在同一处。以纸媒排版承载文字，用月球与行旅地图连接照片和地点。</p>
        <div class="project-links">
          <a href="/">体验本站 <span aria-hidden="true">→</span></a>
          <a href={repository} target="_blank" rel="noopener">查看源码 <span aria-hidden="true">↗</span></a>
        </div>
      </header>

      <figure class="project-preview reveal">
        <a href="/" aria-label="体验月亮首页">
          <Image src={homePreview} alt="本站深色首页的实际界面：手写署名、自转月球与浮尘" format="webp" widths={[480, 960, 1280]} sizes="(max-width: 768px) calc(100vw - 36px), (max-width: 1080px) calc(100vw - 56px), 1024px" loading="eager" />
        </a>
        <figcaption><span>月亮首页</span><span>滚动，让月面消散成一帧风景。</span></figcaption>
      </figure>

      <div class="project-features">
        <section class="project-feature reveal" aria-labelledby="atlas-title">
          <a class="feature-preview" href="/zhen/" aria-label="探索行旅图集">
            <Image src={atlasPreview} alt="行旅图集的实际界面：贵州相册与标记旅行地点的三维地球" format="webp" widths={[480, 640, 960]} sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1080px) calc((100vw - 88px) / 2), 496px" loading="lazy" />
          </a>
          <h3 id="atlas-title">行旅图集</h3>
          <p>在地球与平面地图之间切换，点选坐标，沿着地点进入每一辑旅行记录。</p>
          <a class="feature-link" href="/zhen/">探索地图 <span aria-hidden="true">→</span></a>
        </section>
        <section class="project-feature reveal" aria-labelledby="gallery-title">
          <a class="feature-preview" href="/zhen/nanjing/" aria-label="浏览南京摄影相册">
            <Image src={galleryPreview} alt="南京相册的实际大图预览界面" format="webp" widths={[480, 640, 960]} sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1080px) calc((100vw - 88px) / 2), 496px" loading="lazy" />
          </a>
          <h3 id="gallery-title">摄影相册</h3>
          <p>把照片与文字放进同一篇行旅记录。点开照片查看大图，在一辑影像中前后浏览。</p>
          <a class="feature-link" href="/zhen/nanjing/">浏览南京相册 <span aria-hidden="true">→</span></a>
        </section>
      </div>

      <section class="project-implementation reveal" aria-labelledby="implementation-title">
        <h3 id="implementation-title">设计与实现</h3>
        <dl class="implementation-list">
          <div><dt>阅读</dt><dd>「知·思·帧·馥·聆」五个栏目共用字体与主题，文章配有阅读进度条，唱片页收录喜欢的歌与听后感，提供试听和平台入口。</dd></div>
          <div><dt>交互</dt><dd>Three.js 呈现月球、粒子过渡与行旅地球；保留键盘操作、触控和静态回退。</dd></div>
          <div><dt>维护</dt><dd>Markdown 内容自动生成页面与 RSS，构建时生成字体子集和响应式图片。</dd></div>
        </dl>
        <div class="project-stack"><span>Astro 5 · TypeScript · Three.js · Sharp</span><a href={`${repository}#readme`} target="_blank" rel="noopener">阅读实现说明 <span aria-hidden="true">↗</span></a></div>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .page-heading { margin-bottom: 24px; }
  .works-intro { max-width: var(--content-width); margin-bottom: 56px; color: var(--text-muted); font-size: 18px; }
  .project { border-top: 1px solid var(--list-divider); padding-top: 28px; }
  .project-kicker { display: flex; align-items: center; justify-content: space-between; gap: 20px; color: var(--list-text-muted); font-size: 12px; letter-spacing: .08em; }
  .project-status { display: inline-flex; align-items: center; gap: 8px; }
  .project-status::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .project-title { margin-top: 24px; font-size: clamp(32px, 5vw, 48px); line-height: 1.2; font-weight: 400; letter-spacing: -.02em; }
  .project-subtitle { margin-top: 12px; font-size: 20px; }
  .project-description { max-width: var(--content-width); margin-top: 18px; font-size: 17px; color: var(--list-text-muted); line-height: 1.9; }
  .project-links { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 24px; }
  .project-links a, .feature-link, .project-stack a { display: inline-flex; align-items: center; gap: 16px; min-height: 44px; font-size: 15px; }
  .project a:hover { color: var(--text); transform: none; }
  .project-links a:hover, .feature-link:hover, .project-stack a:hover { text-decoration: underline; }
  .project a:focus-visible { outline: 2px solid var(--text); outline-offset: 5px; }
  .project-preview { margin-top: 32px; }
  .project-preview > a, .feature-preview { display: block; overflow: hidden; border: 1px solid var(--list-divider); background: var(--bg-alt); }
  .project-preview img, .feature-preview img { width: 100%; height: auto; }
  .project-preview figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 20px; margin-top: 12px; color: var(--list-text-muted); font-size: 13px; }
  .project-features { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; margin-top: 48px; }
  .project-feature { min-width: 0; }
  .project-feature h3 { margin: 20px 0 8px; font-size: 23px; font-weight: 400; }
  .project-feature p { color: var(--list-text-muted); font-size: 16px; line-height: 1.85; }
  .feature-link { margin-top: 12px; }
  .project-implementation { border-top: 1px solid var(--list-divider); margin-top: 48px; padding-top: 28px; }
  .project-implementation h3 { font-size: 23px; font-weight: 400; margin-bottom: 24px; }
  .implementation-list { display: grid; gap: 18px; }
  .implementation-list > div { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 24px; font-size: 16px; }
  .implementation-list dt { color: var(--text); }
  .implementation-list dd { color: var(--list-text-muted); }
  .project-stack { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; border-top: 1px solid var(--list-divider); margin-top: 28px; padding-top: 20px; }
  .project-stack > span { font-size: 13px; color: var(--list-text-muted); }
  @media (max-width: 700px) {
    .works-intro { margin-bottom: 36px; }
    .project-features { grid-template-columns: 1fr; gap: 32px; margin-top: 32px; }
    .project-subtitle { font-size: 18px; }
    .project-description { font-size: 16px; }
    .project-implementation { margin-top: 32px; }
    .implementation-list > div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
