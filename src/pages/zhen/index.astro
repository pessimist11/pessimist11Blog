---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListDate from '@/components/ListDate.astro';
import { getCollection } from 'astro:content';
import TravelMap from '@/components/TravelMap.astro';
import { galleryImage } from '@/lib/gallery';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const posts = await getCollection('zhen');
const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// 帧总数 = 相册实际照片数（与各辑「N帧」标签口径一致）。
//
// 这里读 optimize-gallery.mjs 生成的清单，而不是 import.meta.glob 图片目录：
// 那个 glob 会匹配到 76 张原图，Vite 会把匹配集里每一张都发射进 dist/_astro/
// （约 20 MB，而页面从不引用它们），只为拿一个数字不值得。
//
// 用 process.cwd() 拼路径：src/pages/ 下的页面在构建时 import.meta.url
// 指向编译产物而非源文件，相对路径会算错（BaseLayout 能用纯属目录深度巧合）。
let totalFrames = 0;
try {
  const manifest = JSON.parse(readFileSync(path.resolve('public/gallery/manifest.json'), 'utf8'));
  totalFrames = Object.keys(manifest).length;
} catch {
  console.warn('[zhen] 未找到 public/gallery/manifest.json，先运行 npm run gallery');
}

// 去过的地方（地图用）
const places = sorted
  .filter(p => typeof p.data.lat === 'number' && typeof p.data.lng === 'number')
  .map(p => ({
    name: p.data.title,
    location: p.data.location || '',
    date: p.data.pubDate.toISOString().slice(0, 10),
    frames: new Set([...p.body.matchAll(/!\[[^\]]*\]\((\/gallery\/[^)\s]+)\)/g)].map(match => match[1])).size || p.data.coverImages?.length || (p.data.coverImage ? 1 : 0),
    image: galleryImage(p.data.coverImage || p.data.coverImages?.[0]),
    description: p.data.description,
    lat: p.data.lat as number,
    lng: p.data.lng as number,
    href: `/zhen/${p.id.replace(/\.(md|mdx)$/, '')}/`,
    latest: p.id === sorted[0]?.id,
  }));
---

<BaseLayout title="帧">
  <div class="page-wrap reveal">
    <a href="/" class="back-link">← 返回<span> 首页</span></a>
    <div class="page-heading">
      <h1 class="page-heading-zh">帧</h1>
    </div>
    <p class="section-intro">镜头截取的时间切片，快门按下记录不可逆的一帧。</p>

    <TravelMap places={places} />

    <div class="zhen-archive-heading"><h2>行旅档案</h2><span>{totalFrames} 帧 · {sorted.length} 辑</span></div>
    <ul class="magazine-list">
      {sorted.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/zhen/${post.id.replace(/\.(md|mdx)$/, '')}/`}>
            <div class="magazine-date">
              <ListDate date={post.data.pubDate} />
              {post.data.location && <><br />{post.data.location}</>}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>

</BaseLayout>

<style>
  .page-heading { margin-bottom: 24px; }
  .section-intro { margin-bottom: 28px; }
  .zhen-archive-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 18px;
    color: var(--list-text-muted);
  }
  .zhen-archive-heading h2 { font-size: 15px; font-weight: 400; letter-spacing: .12em; }
  .zhen-archive-heading span { font-size: 12px; }
</style>
