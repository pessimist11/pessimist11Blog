---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { galleryImage } from '@/lib/gallery';
import type { ImageMetadata } from 'astro';

const posts = await getCollection('zhen');
const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// 收集所有帧文章的照片池，构建时随机打乱
const allPhotos = sorted
  .flatMap(p => (p.data.coverImages?.length ? p.data.coverImages : p.data.coverImage ? [p.data.coverImage] : []))
  .map(galleryImage)
  .filter((photo): photo is ImageMetadata => Boolean(photo))
  .sort(() => Math.random() - 0.5);
const galleryPhotos = allPhotos.slice(0, 6);

// 去过的地方（地图用）
const places = sorted
  .filter(p => typeof p.data.lat === 'number' && typeof p.data.lng === 'number')
  .map(p => ({
    name: p.data.title,
    location: p.data.location || '',
    year: p.data.pubDate.getFullYear(),
    lat: p.data.lat as number,
    lng: p.data.lng as number,
  }));
---

<BaseLayout title="帧">
  <div class="page-wrap reveal">
    <a href="/" class="back-link">← 返回<span> 首页</span></a>
    <div class="page-heading">
      <h1 class="page-heading-zh">帧</h1>
    </div>
    <p class="section-intro">镜头截取的时间切片，快门按下记录不可逆的一帧。</p>

    <div id="travel-map" class="travel-map reveal" aria-label="去过的地方地图"></div>

    <!-- 照片墙：两行四张，大小错落 -->
    <div class="zhen-wall">
      {galleryPhotos.map((photo, i) => (
        <a href="/zhen/" class="zhen-wall-item">
          <Image
            src={photo}
            alt=""
            formats={['avif', 'webp']}
            widths={[480, 960, 1600]}
            sizes="(max-width: 768px) 92vw, 30vw"
            width={1600}
            loading={i < 2 ? 'eager' : 'lazy'}
          />
        </a>
      ))}
    </div>

    <ul class="magazine-list">
      {sorted.map(post => (
        <li class="magazine-item">
          <a href={`/zhen/${post.id.replace(/\.(md|mdx)$/, '')}/`}>
            <div class="magazine-date">
              {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
              {post.data.location && <><br />{post.data.location}</>}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <script type="application/json" id="travel-places" set:html={JSON.stringify(places)}></script>

  <script>
    import L from 'leaflet';
    import 'leaflet/dist/leaflet.css';

    const container = document.getElementById('travel-map');
    if (container) {
      let places = [];
      try {
        places = JSON.parse(document.getElementById('travel-places')?.textContent || '[]');
      } catch {
        places = [];
      }

      const accent =
        getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#1a1a1a';

      const map = L.map('travel-map', { scrollWheelZoom: true }).setView([33, 112], 4);

      const lightTiles = L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 19,
      });
      const darkTiles = L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 19,
      });

      function applyTheme() {
        const dark = document.documentElement.dataset.theme === 'dark';
        if (dark && !map.hasLayer(darkTiles)) {
          map.removeLayer(lightTiles);
          darkTiles.addTo(map);
        }
        if (!dark && !map.hasLayer(lightTiles)) {
          map.removeLayer(darkTiles);
          lightTiles.addTo(map);
        }
      }
      applyTheme();

      const markers = places.map(p => {
        const dot = L.circleMarker([p.lat, p.lng], {
          radius: 6,
          color: accent,
          weight: 1,
          fillColor: accent,
          fillOpacity: 0.9,
        }).addTo(map);
        dot.bindPopup(`<strong>${p.name}</strong>${p.location ? ' · ' + p.location : ''}<br/>${p.year}`);
        return dot;
      });

      if (markers.length > 1) {
        map.fitBounds(L.latLngBounds(markers.map(m => m.getLatLng())), {
          padding: [40, 40],
          maxZoom: 6,
        });
      }

      // 主题切换时同步瓦片配色
      document.addEventListener('click', (e) => {
        if (e.target.closest('#themeToggle')) setTimeout(applyTheme, 0);
      });
      window.addEventListener('load', () => map.invalidateSize());
    }
  </script>

  <style>
    .travel-map {
      position: relative;
      z-index: 0;
      height: 440px;
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 48px;
      background: var(--bg-alt);
    }
    .travel-map :global(.leaflet-container) {
      background: var(--bg-alt);
      font-family: var(--font-body);
    }
    .travel-map :global(.leaflet-popup-content-wrapper),
    .travel-map :global(.leaflet-popup-tip) {
      background: var(--surface);
      color: var(--text);
      border-radius: 6px;
    }
    .travel-map :global(.leaflet-popup-content) {
      margin: 10px 14px;
      line-height: 1.6;
    }
    .travel-map :global(.leaflet-control-zoom a) {
      color: var(--text);
      background: var(--surface);
      border-color: var(--border);
    }
    .travel-map :global(.leaflet-control-attribution) {
      background: rgba(255, 255, 255, 0.7);
      color: var(--text-faint);
    }
    @media (max-width: 768px) {
      .travel-map {
        height: 320px;
      }
    }
  </style>
</BaseLayout>
