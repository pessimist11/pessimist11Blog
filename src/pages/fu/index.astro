---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const pageTitle = '馥 · 香水评价';

const posts = await getCollection('fu');
const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title={pageTitle}>
  <div class="page-header">
    <h1>🌸 馥</h1>
    <div class="page-desc">香气馥郁，嗅觉与审美体验</div>
  </div>

  <ul class="post-list">
    {sorted.map(post => (
      <li class="post-item">
        <a href={`/fu/${post.id}/`}>
          <div class="post-title">{post.data.title}</div>
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            {post.data.brand && ` · ${post.data.brand}`}
            {post.data.rating && ` · ${'★'.repeat(post.data.rating)}${'☆'.repeat(5 - post.data.rating)}`}
          </div>
          {post.data.description && <div class="post-desc">{post.data.description}</div>}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
