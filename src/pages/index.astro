---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { galleryImage } from '@/lib/gallery';
import type { ImageMetadata } from 'astro';

const zhi = await getCollection('zhi');
const si = await getCollection('si');
const zhen = await getCollection('zhen');
const fu = await getCollection('fu');

const zhiPosts = zhi.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
const siPosts = si.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
const fuPosts = fu.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);

const zhenPosts = zhen.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);

// 收集帧文章的所有封面照片，构建时随机打乱
// 只取横构图：首页大图现在是全宽出血的宽幅裁切（桌面约 2.4:1），
// 竖构图会被裁掉大半，只剩中间一条，观感很差。
const allPhotos = zhen
  .flatMap(p => (p.data.coverImages?.length ? p.data.coverImages : p.data.coverImage ? [p.data.coverImage] : []))
  .map(galleryImage)
  .filter((photo): photo is ImageMetadata => Boolean(photo))
  .filter((photo) => photo.width >= photo.height)
  .sort(() => Math.random() - 0.5);
const featuredPhoto = allPhotos[0] ?? galleryImage('/gallery/nanjing/DSCF0876.jpg')!;

function slug(id: string) {
  return id.replace(/\.(md|mdx)$/, '');
}
---

<BaseLayout title="首页">
  <!-- 在页面顶部继续下拉时浮现，提示可返回封面 -->
  <div class="cover-pull" data-cover-pull aria-hidden="true">
    <span class="cover-pull-label">下拉返回封面</span>
    <span class="cover-pull-bar" data-cover-pull-bar></span>
  </div>

    <section class="hero reveal">
    <h1 class="hero-name">PESSIMIST11</h1>
    <p class="hero-tagline">记录无意义的生命中可能有意义的瞬间</p>
  </section>

  <div class="feature-photo reveal">
    <div class="feature-photo-inner">
      <Image
        src={featuredPhoto}
        alt=""
        formats={['avif', 'webp']}
        widths={[480, 960, 1600]}
        sizes="100vw"
        width={1600}
        fetchpriority="high"
        loading="eager"
      />
    </div>
  </div>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">知</h2>
    </div>
    <ul class="magazine-list">
      {zhiPosts.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/zhi/${slug(post.id)}/`}>
            <div class="magazine-date">
              {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/zhi/" class="more-link">全部 <strong>知</strong> →</a>
  </section>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">思</h2>
    </div>
    <ul class="magazine-list">
      {siPosts.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/si/${slug(post.id)}/`}>
            <div class="magazine-date">
              {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/si/" class="more-link">全部 <strong>思</strong> →</a>
  </section>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">帧</h2>
    </div>
    <ul class="magazine-list">
      {zhenPosts.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/zhen/${slug(post.id)}/`}>
            <div class="magazine-date">
              {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/zhen/" class="more-link">全部 <strong>帧</strong> →</a>
  </section>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">馥</h2>
    </div>
    <ul class="magazine-list">
      {fuPosts.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/fu/${slug(post.id)}/`}>
            <div class="magazine-date">
              {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/fu/" class="more-link">全部 <strong>馥</strong> →</a>
  </section>

  <style>
    .cover-pull {
      position: fixed;
      top: calc(var(--nav-height) + 10px);
      left: 50%;
      z-index: 90;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      padding: 7px 16px 9px;
      font-size: 12px;
      letter-spacing: 0.2em;
      text-indent: 0.2em;
      color: var(--text-muted);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 999px;
      opacity: 0;
      transform: translate(-50%, -8px) scale(0.96);
      transition: opacity 0.18s ease, transform 0.18s ease;
      pointer-events: none;
    }

    .cover-pull.is-active {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }

    /* 进度条随下拉量增长 */
    .cover-pull-bar {
      width: 46px;
      height: 2px;
      border-radius: 2px;
      background: var(--border-strong);
      overflow: hidden;
    }

    .cover-pull-bar::after {
      content: '';
      display: block;
      height: 100%;
      width: calc(var(--pull, 0) * 100%);
      background: var(--text-muted);
    }

    /* 离场：整屏淡出后进入封面。
       注意要作用在 body 上 —— 若分别写 .hero / .home-section，
       权重会低于 .js .reveal.visible 的 opacity:1，导致淡出失效。 */
    html.leaving body {
      opacity: 0;
      transition: opacity 0.42s ease;
    }

    @media (prefers-reduced-motion: reduce) {
      .cover-pull { transition: none; }
      html.leaving body { transition: none; }
    }
  </style>

  <script>
    // 主页顶部「继续下拉 → 返回封面 /enter/」
    //
    // 为什么不是「上滑」：在页面顶部，手指上滑＝正常向下滚动，
    // 拿它做返回会和浏览冲突。返回只能绑定「反向超滚」，即已经在顶部还继续往下拉。
    // 滚轮 / 触摸 / 键盘 都支持，触发阈值 150（滚轮像素≈触摸像素的量级）。
    // 两套阈值：滚轮 deltaY 与触摸像素不可比，触摸 150px 已是很刻意的下拉
    const WHEEL_THRESHOLD = 260;
    const TOUCH_THRESHOLD = 150;
    const THRESHOLD = 260; // 进度条按滚轮口径显示
    let pull = 0;
    let leaving = false;
    let atTopSince = 0;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const indicator = document.querySelector('[data-cover-pull]');
    const bar = document.querySelector('[data-cover-pull-bar]');

    let hideTimer = 0;

    function render() {
      if (!indicator) return;
      const p = Math.min(pull / THRESHOLD, 1);
      indicator.classList.toggle('is-active', p > 0.04);
      indicator.style.setProperty('--pull', p.toFixed(3));
      if (bar) bar.parentElement?.style.setProperty('--pull', p.toFixed(3));
    }

    function scheduleReset() {
      clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => {
        pull = 0;
        render();
      }, 260);
    }

    function goCover() {
      if (leaving) return;
      leaving = true;
      if (reduced) {
        location.href = '/enter/';
        return;
      }
      document.documentElement.classList.add('leaving');
      window.setTimeout(() => { location.href = '/enter/'; }, 430);
    }

    // 必须「已经在顶部停留 250ms」之后才开始计入。
    // 否则用户快速上滚到顶时，滚动惯性会被当成返回意图，直接被弹到封面页。
    function ready() {
      if (window.scrollY > 1) {
        atTopSince = 0;
        return false;
      }
      const now = performance.now();
      if (!atTopSince) atTopSince = now;
      return now - atTopSince > 250;
    }

    // 只有已经在页面顶部、且继续向下拉（deltaY < 0）才累计
    function addPull(amount) {
      if (leaving) return;
      pull += amount;
      if (pull >= THRESHOLD) {
        goCover();
        return;
      }
      render();
      scheduleReset();
    }

    window.addEventListener('wheel', (e) => {
      if (e.deltaY >= 0 || !ready()) {
        pull = 0;
        render();
        return;
      }
      pull += -e.deltaY;
      if (pull >= WHEEL_THRESHOLD) {
        goCover();
        return;
      }
      render();
      scheduleReset();
    }, { passive: true });

    let touchAnchor = null;
    window.addEventListener('touchstart', (e) => {
      touchAnchor = ready() ? e.touches[0].clientY : null;
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (touchAnchor === null || leaving) return;
      if (window.scrollY > 1) { touchAnchor = null; pull = 0; render(); return; }
      // 手指向下拖为正
      const dy = e.touches[0].clientY - touchAnchor;
      if (dy <= 0) { pull = 0; render(); return; }
      pull = dy;
      if (pull >= TOUCH_THRESHOLD) { goCover(); return; }
      render();
    }, { passive: true });

    window.addEventListener('touchend', () => {
      touchAnchor = null;
      scheduleReset();
    }, { passive: true });

    // 顶部按上下方向键 / PageUp 也当作回退意图
    window.addEventListener('keydown', (e) => {
      if (!ready()) return;
      if (e.key === 'ArrowUp' || e.key === 'PageUp') addPull(60);
    });
  </script>
</BaseLayout>
