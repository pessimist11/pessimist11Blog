---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ListDate from '@/components/ListDate.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { galleryImage } from '@/lib/gallery';
import type { ImageMetadata } from 'astro';

const zhi = await getCollection('zhi');
const si = await getCollection('si');
const zhen = await getCollection('zhen');
const fu = await getCollection('fu');

const zhiPosts = zhi.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
const siPosts = si.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
const fuPosts = fu.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);

const zhenPosts = zhen.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);

// 收集帧文章的所有封面照片，构建时随机打乱
// 只取横构图：首页大图以全屏宽幅呈现，
// 竖构图会被裁掉大半，只剩中间一条，观感很差。
const allPhotos = zhen
  .flatMap(p => (p.data.coverImages?.length ? p.data.coverImages : p.data.coverImage ? [p.data.coverImage] : []))
  .map(galleryImage)
  .filter((photo): photo is ImageMetadata => Boolean(photo))
  .filter((photo) => photo.width >= photo.height)
  .sort(() => Math.random() - 0.5);
const featuredPhoto = allPhotos[0] ?? galleryImage('/gallery/nanjing/DSCF0876.jpg')!;

function slug(id: string) {
  return id.replace(/\.(md|mdx)$/, '');
}

// 封面题句（与入场页一致）
const verse = ['记录无意义的生命中', '可能有意义的瞬间'];
---

<BaseLayout title="首页" immersiveHeader>
  <!-- 月面粒子剥离为云带，再带着照片的色彩聚合成像。 -->
  <section class="cover" data-cover aria-label="月与浮尘">
    <div class="cover-stage" data-lunar-stage>
      <div class="cover-art">
        <div class="cover-fallback" aria-hidden="true"></div>
        <canvas data-lunar aria-hidden="true"></canvas>
        <div class="cover-grain" aria-hidden="true"></div>
        <div class="cover-intro">
          <h1 class="cover-sig" aria-label="Pessimist"><span>Pessimist</span></h1>
          <p class="cover-verse">{verse[0]}<br />{verse[1]}</p>
        </div>
        <div class="cover-index" aria-hidden="true">知 · 思 · 帧 · 馥</div>
        <a class="cover-cue" href="#selected-photo">
          <span>向下探索</span><span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="cover-photo">
        <Image
          src={featuredPhoto}
          alt="旅途中记录的风景"
          formats={['avif', 'webp']}
          widths={[480, 960, 1600]}
          sizes="100vw"
          width={1600}
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
    <span id="selected-photo" class="cover-photo-anchor" aria-hidden="true"></span>
    <noscript>
      <style is:inline>
        html:not(.js) .cover { height: auto; }
        html:not(.js) .cover-stage { position: relative; top: 0; height: auto; min-height: 0; }
        html:not(.js) .cover-art { position: relative; height: var(--lunar-stage-height); }
        html:not(.js) .cover-photo { position: relative; height: clamp(260px, 46vw, 600px); }
        html:not(.js) .cover canvas { display: none; }
        html:not(.js) .cover-photo-anchor { top: var(--lunar-stage-height); }
      </style>
    </noscript>
  </section>

  <section class="home-section home-section--signed reveal">
    <div class="watermark" aria-hidden="true">pessimist11</div>
    <div class="home-section-heading">
      <h2 class="home-section-zh">知</h2>
    </div>
    <ul class="magazine-list">
      {zhiPosts.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/zhi/${slug(post.id)}/`}>
            <div class="magazine-date">
              <ListDate date={post.data.pubDate} />
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/zhi/" class="more-link">全部 <strong>知</strong> →</a>
  </section>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">思</h2>
    </div>
    <ul class="magazine-list">
      {siPosts.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/si/${slug(post.id)}/`}>
            <div class="magazine-date">
              <ListDate date={post.data.pubDate} />
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/si/" class="more-link">全部 <strong>思</strong> →</a>
  </section>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">帧</h2>
    </div>
    <ul class="magazine-list">
      {zhenPosts.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/zhen/${slug(post.id)}/`}>
            <div class="magazine-date">
              <ListDate date={post.data.pubDate} />
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/zhen/" class="more-link">全部 <strong>帧</strong> →</a>
  </section>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">馥</h2>
    </div>
    <ul class="magazine-list">
      {fuPosts.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/fu/${slug(post.id)}/`}>
            <div class="magazine-date">
              <ListDate date={post.data.pubDate} />
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/fu/" class="more-link">全部 <strong>馥</strong> →</a>
  </section>

  <style>
    @font-face {
      font-family: 'Caveat';
      src: url('../assets/fonts/caveat-signature.woff2') format('woff2');
      font-weight: 400 700;
      font-style: normal;
      font-display: swap;
    }

    .cover {
      --lunar-stage-height: max(480px, 100svh);
      position: relative;
      height: 300svh;
      background: var(--bg);
    }

    .cover-stage {
      position: sticky;
      top: 0;
      height: var(--lunar-stage-height);
      overflow: hidden;
      isolation: isolate;
      background: var(--bg);
    }

    .cover-art {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: var(--bg);
      opacity: var(--lunar-scene, 1);
      pointer-events: none;
    }
    .cover-photo {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }
    .cover[data-renderer='three'] .cover-photo { opacity: var(--lunar-photo, 0); }
    .cover-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .cover-photo-anchor {
      position: absolute;
      top: calc(100% - var(--lunar-stage-height));
      width: 1px;
      height: 1px;
      pointer-events: none;
    }

    .cover canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      opacity: 0;
      transition: opacity 0.7s ease;
    }
    .cover[data-renderer='three'] canvas { opacity: 1; }

    .cover-fallback {
      position: absolute;
      left: 69%;
      top: 44.5%;
      width: min(51vw, 59svh);
      aspect-ratio: 1;
      transform: translate(-50%, -50%) rotate(6deg);
      border-radius: 50%;
      background: url('../assets/moon/lroc-albedo.webp') 27% 50% / 200% 100%;
      box-shadow: inset 24px 5px 42px color-mix(in srgb, var(--bg) 50%, transparent);
      opacity: 0.47;
      filter: grayscale(1);
      transition: opacity 0.7s ease;
    }
    :global([data-theme='dark']) .cover-fallback { opacity: 0.85; }
    .cover[data-renderer='three'] .cover-fallback { opacity: 0; }
    .cover[data-renderer='fallback'] { height: auto; }
    .cover[data-renderer='fallback'] .cover-photo-anchor { top: var(--lunar-stage-height); }
    .cover[data-renderer='fallback'] .cover-stage { position: relative; top: 0; height: auto; min-height: 0; }
    .cover[data-renderer='fallback'] .cover-art { position: relative; height: var(--lunar-stage-height); }
    .cover[data-renderer='fallback'] .cover-photo { position: relative; height: clamp(260px, 46vw, 600px); }

    .cover-grain {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: calc(0.11 * var(--lunar-grain, 1));
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.93' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' opacity='.26' filter='url(%23n)'/%3E%3C/svg%3E");
      background-size: 160px 160px;
      mix-blend-mode: multiply;
    }
    :global([data-theme='dark']) .cover-grain { mix-blend-mode: screen; opacity: calc(0.075 * var(--lunar-grain, 1)); }

    .cover-intro {
      position: absolute;
      top: 35%;
      left: 10%;
      width: 40%;
      text-align: left;
      opacity: var(--lunar-intro, 1);
      pointer-events: none;
    }

    .cover-sig {
      margin: 0 0 clamp(30px, 6vh, 62px) -0.03em;
      font-family: 'Caveat', 'EB Garamond', cursive;
      font-size: clamp(88px, 9.2vw, 144px);
      font-weight: 600;
      line-height: 1.04;
      letter-spacing: -0.035em;
      color: var(--text);
      transform: rotate(-4deg);
      transform-origin: left center;
    }
    .cover-sig span { display: inline-block; }
    :global(.js) .cover-sig span {
      clip-path: inset(-20% 100% -20% -5%);
      animation: signature-write 3.4s cubic-bezier(0.25, 0.45, 0.45, 1) 0.2s forwards;
    }
    @keyframes signature-write { to { clip-path: inset(-20% -5% -20% -5%); } }

    .cover-verse {
      margin: 0;
      color: var(--text-muted);
      font-size: clamp(15px, 1.35vw, 19px);
      font-weight: 400;
      line-height: 2.2;
      letter-spacing: 0.08em;
    }

    .cover-index {
      position: absolute;
      left: 10%;
      bottom: 8%;
      font-size: 12px;
      letter-spacing: 0.3em;
      color: var(--text-muted);
      opacity: var(--lunar-cue, 1);
    }
    .cover-cue {
      position: absolute;
      right: 10%;
      bottom: 8%;
      display: flex;
      align-items: center;
      gap: 22px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border-strong);
      color: var(--text-muted);
      font-size: 15px;
      letter-spacing: 0.08em;
      opacity: var(--lunar-cue, 1);
      pointer-events: auto;
    }
    .cover-cue:hover { color: var(--text); transform: none; }
    .cover-cue:focus-visible { outline: 2px solid var(--text); outline-offset: 6px; opacity: 1; }
    #selected-photo { scroll-margin-top: 0; }

    @media (max-width: 700px) {
      .cover { --lunar-stage-height: max(560px, 100svh); height: 280svh; }
      .cover-intro { left: 9%; top: 16%; width: 82%; }
      .cover-sig { font-size: clamp(72px, 19vw, 110px); margin-bottom: 20px; }
      .cover-verse { font-size: 14px; line-height: 2; }
      .cover-fallback { left: 58%; top: 61%; width: min(86vw, 43svh); }
      .cover-index { left: 9%; bottom: 6%; font-size: 11px; }
      .cover-cue { right: 9%; bottom: 6%; font-size: 13px; gap: 16px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .cover { height: auto; }
      .cover-stage { position: relative; top: 0; height: auto; min-height: 0; }
      .cover-art { position: relative; height: var(--lunar-stage-height); }
      .cover-photo, .cover[data-renderer='three'] .cover-photo { position: relative; height: clamp(260px, 46vw, 600px); opacity: 1; }
      .cover-photo-anchor { top: var(--lunar-stage-height); }
      .cover canvas, .cover-fallback { transition: none; }
      :global(.js) .cover-sig span { clip-path: none; animation: none; }
    }
  </style>

  <script>
    import '@/lib/lunar';
  </script>
</BaseLayout>
