---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { galleryImage } from '@/lib/gallery';
import type { ImageMetadata } from 'astro';

const zhi = await getCollection('zhi');
const si = await getCollection('si');
const zhen = await getCollection('zhen');
const fu = await getCollection('fu');

const zhiPosts = zhi.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
const siPosts = si.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
const fuPosts = fu.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);

const zhenPosts = zhen.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);

// 收集帧文章的所有封面照片，构建时随机打乱
// 只取横构图：首页大图现在是全宽出血的宽幅裁切（桌面约 2.4:1），
// 竖构图会被裁掉大半，只剩中间一条，观感很差。
const allPhotos = zhen
  .flatMap(p => (p.data.coverImages?.length ? p.data.coverImages : p.data.coverImage ? [p.data.coverImage] : []))
  .map(galleryImage)
  .filter((photo): photo is ImageMetadata => Boolean(photo))
  .filter((photo) => photo.width >= photo.height)
  .sort(() => Math.random() - 0.5);
const featuredPhoto = allPhotos[0] ?? galleryImage('/gallery/nanjing/DSCF0876.jpg')!;

function slug(id: string) {
  return id.replace(/\.(md|mdx)$/, '');
}

// 封面题句（与入场页一致）
const verse = ['记录无意义的生命中', '可能有意义的瞬间'];
---

<BaseLayout title="首页">
  <!-- 第一屏：水墨月景封面。往下滚就露出下面的栏目，滚回顶部就又回到这里 -->
  <section class="cover" data-cover aria-label="封面">
    <canvas data-lunar aria-hidden="true"></canvas>
    <div class="cover-grain" aria-hidden="true"></div>
    <div class="cover-fallback" aria-hidden="true"></div>

    <div class="cover-intro">
      <h1 class="cover-sig">PESSIMIST11</h1>
      <p class="cover-verse">
        {verse[0]}<br />{verse[1]}
      </p>
    </div>

    <div class="cover-cue" aria-hidden="true">
      <span class="cover-cue-arrow">↓</span>
      <span class="cover-cue-bar"></span>
    </div>
  </section>

  <div class="feature-photo reveal">
    <div class="feature-photo-inner">
      <Image
        src={featuredPhoto}
        alt=""
        formats={['avif', 'webp']}
        widths={[480, 960, 1600]}
        sizes="100vw"
        width={1600}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">知</h2>
    </div>
    <ul class="magazine-list">
      {zhiPosts.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/zhi/${slug(post.id)}/`}>
            <div class="magazine-date">
              {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/zhi/" class="more-link">全部 <strong>知</strong> →</a>
  </section>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">思</h2>
    </div>
    <ul class="magazine-list">
      {siPosts.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/si/${slug(post.id)}/`}>
            <div class="magazine-date">
              {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/si/" class="more-link">全部 <strong>思</strong> →</a>
  </section>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">帧</h2>
    </div>
    <ul class="magazine-list">
      {zhenPosts.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/zhen/${slug(post.id)}/`}>
            <div class="magazine-date">
              {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/zhen/" class="more-link">全部 <strong>帧</strong> →</a>
  </section>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">馥</h2>
    </div>
    <ul class="magazine-list">
      {fuPosts.map((post, i) => (
        <li class="magazine-item reveal" style={`--i: ${i}`}>
          <a href={`/fu/${slug(post.id)}/`}>
            <div class="magazine-date">
              {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a href="/fu/" class="more-link">全部 <strong>馥</strong> →</a>
  </section>

  <style>
    /* ── 第一屏：水墨月景封面 ───────────────────────── */
    .cover {
      position: relative;
      height: 100svh;
      min-height: 540px;
      overflow: hidden;
      background: var(--bg);
    }

    .cover canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    /* 纸的纤维质地：叠在月景上，也让无 WebGL 时页面不空 */
    .cover-grain {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0.5;
      mix-blend-mode: multiply;
      background-image:
        radial-gradient(circle at 18% 26%, rgba(0, 0, 0, 0.025) 0 1px, transparent 1px),
        radial-gradient(circle at 63% 71%, rgba(0, 0, 0, 0.02) 0 1px, transparent 1px),
        radial-gradient(circle at 84% 18%, rgba(0, 0, 0, 0.018) 0 1px, transparent 1px);
      background-size: 7px 7px, 11px 11px, 13px 13px;
    }

    :global([data-theme='dark']) .cover-grain {
      mix-blend-mode: screen;
      opacity: 0.25;
      background-image:
        radial-gradient(circle at 18% 26%, rgba(255, 255, 255, 0.03) 0 1px, transparent 1px),
        radial-gradient(circle at 63% 71%, rgba(255, 255, 255, 0.024) 0 1px, transparent 1px);
    }

    /* 无 WebGL 时的兜底月亮 */
    .cover-fallback {
      display: none;
      position: absolute;
      left: 50%;
      top: 50%;
      width: min(42vmin, 360px);
      aspect-ratio: 1;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background:
        radial-gradient(circle at 34% 30%, rgba(0, 0, 0, 0.07) 0 9%, transparent 10%),
        radial-gradient(circle at 62% 58%, rgba(0, 0, 0, 0.055) 0 12%, transparent 13%),
        radial-gradient(circle at 46% 74%, rgba(0, 0, 0, 0.045) 0 8%, transparent 9%),
        radial-gradient(circle at 38% 34%, rgba(0, 0, 0, 0.015) 0%, rgba(0, 0, 0, 0.09) 100%);
      opacity: 0.9;
    }

    :global(html.no-webgl) .cover-fallback { display: block; }
    :global(html.no-webgl) .cover canvas { display: none; }

    .cover-intro {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: min(88vw, 720px);
      text-align: center;
      pointer-events: none;
    }

    .cover-sig {
      margin: 0 0 clamp(18px, 3.4vh, 38px);
      font-family: 'EB Garamond', 'Noto Serif SC', serif;
      font-size: clamp(25px, 4.4vw, 46px);
      font-weight: 400;
      letter-spacing: 0.24em;
      text-indent: 0.24em;
      color: var(--text);
      clip-path: inset(0 100% 0 0);
      animation: ink-write 2.4s cubic-bezier(0.16, 0.84, 0.28, 1) 0.3s forwards;
    }

    /* 墨迹自左向右渗出，模拟运笔 */
    @keyframes ink-write {
      to { clip-path: inset(0 0 0 0); }
    }

    .cover-verse {
      margin: 0;
      font-size: clamp(14px, 1.4vw, 18px);
      line-height: 2.1;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      opacity: 0;
      animation: cover-rise 1.6s ease 2s forwards;
    }

    @keyframes cover-rise {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: none; }
    }

    .cover-cue {
      position: absolute;
      left: 50%;
      bottom: clamp(18px, 3.4vh, 42px);
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      color: var(--text-faint);
      opacity: 0;
      animation: cover-rise 1.2s ease 2.5s forwards;
      pointer-events: none;
    }

    .cover-cue-arrow { font-size: 14px; line-height: 1; }

    .cover-cue-bar {
      width: 1px;
      height: 30px;
      background: linear-gradient(to bottom, transparent, var(--text-faint) 40%, var(--text-muted));
      animation: cue-slide 2.6s ease-in-out infinite;
    }

    @keyframes cue-slide {
      0%   { transform: scaleY(0.3); opacity: 0; }
      35%  { opacity: 1; }
      100% { transform: scaleY(1); opacity: 0.15; }
    }

    @media (prefers-reduced-motion: reduce) {
      .cover-sig { clip-path: none; animation: none; }
      .cover-verse, .cover-cue { opacity: 1; animation: none; }
      .cover-cue-bar { animation: none; }
    }
  </style>

  <script>
    import * as THREE from 'three';

    const canvas = document.querySelector('[data-lunar]');
    const cover = document.querySelector('[data-cover]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

const vert = /* glsl */ `
        void main() {
          gl_Position = vec4(position.xy, 0.0, 1.0);
        }
      `;

      // 片元着色器：一屏画完「纸 + 月 + 云」。
      // 月亮用解析球面求交（不需要几何体），云用横向拉伸的 fbm 噪声带。
      const frag = /* glsl */ `
        precision highp float;

        uniform vec2  uRes;
        uniform float uTime;
        uniform float uCamZ;
        uniform vec3  uPaper;   // 纸色
        uniform vec3  uInk;     // 墨色
        uniform vec3  uLight;   // 受光方向（只用来给月面一点体积感）

        float hash(vec3 p) {
          p = fract(p * 0.3183099 + vec3(0.1, 0.2, 0.3));
          p *= 17.0;
          return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
        }

        float noise(vec3 x) {
          vec3 i = floor(x);
          vec3 f = fract(x);
          f = f * f * (3.0 - 2.0 * f);
          return mix(
            mix(mix(hash(i + vec3(0.0, 0.0, 0.0)), hash(i + vec3(1.0, 0.0, 0.0)), f.x),
                mix(hash(i + vec3(0.0, 1.0, 0.0)), hash(i + vec3(1.0, 1.0, 0.0)), f.x), f.y),
            mix(mix(hash(i + vec3(0.0, 0.0, 1.0)), hash(i + vec3(1.0, 0.0, 1.0)), f.x),
                mix(hash(i + vec3(0.0, 1.0, 1.0)), hash(i + vec3(1.0, 1.0, 1.0)), f.x), f.y),
            f.z);
        }

        float fbm(vec3 p) {
          float v = 0.0;
          float a = 0.5;
          for (int i = 0; i < 5; i++) {
            v += a * noise(p);
            p *= 2.07;
            a *= 0.5;
          }
          return v;
        }

        // 三角波：周期函数，但不需要三角函数。浮尘每像素要算 18 个格子，
        // 用 sin 做漂浮/闪烁的话一帧就是上亿次超越函数调用，集显会掉帧。
        float tri(float x) {
          return 1.0 - 4.0 * abs(fract(x) - 0.5);
        }

        // 无三角函数哈希：浮尘每像素要算 18 个格子，用 sin 哈希开销过大
        vec2 hash2(vec2 p) {
          vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
          p3 += dot(p3, p3.yzx + 33.33);
          return fract((p3.xx + p3.yz) * p3.zy);
        }

        // 浮尘 / 星屑：屏幕空间网格粒子。
        // 把画面切成格子，每格放一个粒子，查 3×3 邻域避免跨格被裁掉。
        // 比用 THREE.Points 便宜：不需要额外几何体、相机通道和逐帧 CPU 更新。
        float dust(vec2 uv, float scale, float t, float speed, float size) {
          vec2 g = uv * scale;
          vec2 id = floor(g);
          float acc = 0.0;
          for (int y = -1; y <= 1; y++) {
            for (int x = -1; x <= 1; x++) {
              vec2 c = id + vec2(float(x), float(y));
              vec2 h = hash2(c);
              // 格内位置 + 极缓的漂浮（用正弦往复，避免粒子漂出格子）
              vec2 pos = c + 0.5 + (h - 0.5) * 0.72;
              pos.x += tri(t * speed * 0.159 + h.y) * 0.30;
              pos.y += tri(t * speed * 0.124 + h.x + 0.25) * 0.26;
              float d = length(g - pos);
              // 明灭闪烁，让粒子不像静态噪点。用三角波代替 sin，省掉循环内的三角函数
              float ph = fract(t * (0.06 + h.y * 0.05) + h.x);
              float tw = 0.55 + 0.45 * (1.0 - abs(ph * 2.0 - 1.0));
              acc += smoothstep(size, 0.0, d) * tw * (0.3 + 0.7 * h.y);
            }
          }
          return acc;
        }

        // 横向拉伸的水墨云带
        float cloudField(vec2 p, float t) {
          vec2 q = vec2(p.x * 0.85, p.y * 3.2 + t * 0.02);
          float f = fbm(vec3(q, t * 0.03));
          f = smoothstep(0.38, 0.82, f);
          float band = exp(-pow((p.y + 0.03) * 1.85, 2.0));
          return f * band;
        }

        void main() {
          vec2 p = (gl_FragCoord.xy / uRes.xy) * 2.0 - 1.0;
          p.x *= uRes.x / uRes.y;

          vec3 ro = vec3(0.0, 0.0, uCamZ);
          vec3 rd = normalize(vec3(p * 0.287, -1.0));

          // 解析求交：圆心在原点、半径 1
          float b = dot(ro, rd);
          float c = dot(ro, ro) - 1.0;
          float h = b * b - c;

          vec3 col = uPaper;

          if (h > 0.0 && b < 0.0) {
            float t = -b - sqrt(h);
            vec3 pos = ro + rd * t;
            vec3 n = normalize(pos);

            // 绕 Y 轴自转：让贴图随月球转（世界法线反旋得到物体空间法线）
            float a = -uTime * 0.017;
            float cs = cos(a);
            float sn = sin(a);
            vec3 no = vec3(n.x * cs + n.z * sn, n.y, -n.x * sn + n.z * cs);

            // 月海（低频暗斑）与环形山（高频细纹）
            float maria = smoothstep(0.40, 0.70, fbm(no * 2.2));
            float crater = fbm(no * 8.0);

            vec3 moonCol = mix(uPaper, uInk, 0.10 + maria * 0.16);
            moonCol = mix(moonCol, uInk, crater * 0.045);

            // 极轻的受光，只给一点球体感，不画硬阴影
            float diff = dot(n, normalize(uLight));
            moonCol = mix(uPaper, moonCol, 0.80 + 0.20 * smoothstep(-0.7, 0.9, diff));

            // 轮廓羽化：撞点离圆心越近越实，靠近边缘融进纸里
            float impact = length(cross(ro, rd));
            float edge = smoothstep(1.0, 0.955, impact);

            col = mix(col, moonCol, edge);
          }

          // 云叠在最上层 —— 形成「月穿云中」
          float cl = cloudField(p, uTime);
          col = mix(col, uInk, cl * 0.17);

          // 浮尘：细密一层 + 疏朗一层，叠出景深
          float d1 = dust(p, 24.0, uTime, 0.22, 0.052);
          float d2 = dust(p * 0.62 + 7.3, 12.0, uTime, 0.13, 0.085);
          col = mix(col, uInk, clamp(d1 * 0.15 + d2 * 0.11, 0.0, 0.45));

          // 纸纹颗粒，避免大面积平色
          col *= 0.994 + 0.012 * hash(vec3(gl_FragCoord.xy, 3.7));

          gl_FragColor = vec4(col, 1.0);
        }
      `;

    // 配色跟随站点主题：亮色=纸白淡墨，暗色=墨底素月（直接读全局 token）
    function cssColor(name, fallback) {
      const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return new THREE.Color(v || fallback);
    }

    function init() {
      let renderer;
      try {
        renderer = new THREE.WebGLRenderer({ canvas, antialias: false, alpha: false });
      } catch {
        document.documentElement.classList.add('no-webgl');
        return;
      }

      const uniforms = {
        uRes: { value: new THREE.Vector2(1, 1) },
        uTime: { value: 0 },
        uCamZ: { value: 4.5 },
        uPaper: { value: cssColor('--bg', '#f3efe8') },
        uInk: { value: cssColor('--text', '#1a1a1a') },
        uLight: { value: new THREE.Vector3(-0.45, 0.28, 0.85).normalize() },
      };

      const material = new THREE.ShaderMaterial({ uniforms, vertexShader: vert, fragmentShader: frag });
      const scene = new THREE.Scene();
      const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
      scene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material));

      // 画布尺寸跟随封面容器（不再是整屏 fixed）
      function resize() {
        const w = cover.clientWidth;
        const h = cover.clientHeight;
        if (!w || !h) return;
        const cap = Math.min(w, h) < 760 ? 1.5 : 2; // 逐像素着色器，移动端压 DPR 省电
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, cap));
        renderer.setSize(w, h, false);
        uniforms.uRes.value.set(w * renderer.getPixelRatio(), h * renderer.getPixelRatio());
        uniforms.uCamZ.value = 4.5 / Math.max(Math.min(w / h, 1), 0.66);
      }

      let raf = 0;
      let running = false;
      let last = 0;
      let clock = 0;

      function frame(now) {
        // 累加而不是用绝对时间 —— 中途暂停再恢复时月球不会「跳」一下
        if (last) clock += Math.min((now - last) / 1000, 0.05);
        last = now;
        uniforms.uTime.value = clock;
        renderer.render(scene, camera);
        raf = requestAnimationFrame(frame);
      }

      function start() {
        if (running || reduced) return;
        running = true;
        last = 0;
        raf = requestAnimationFrame(frame);
      }

      function stop() {
        running = false;
        cancelAnimationFrame(raf);
        raf = 0;
      }

      // 封面滚出视口就停渲染 —— 否则用户读文章时 GPU 一直空转
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) start();
        else stop();
      }, { threshold: 0 }).observe(cover);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });

      // 主题切换（点导航上的开关）时刷新配色
      new MutationObserver(() => {
        uniforms.uPaper.value = cssColor('--bg', '#f3efe8');
        uniforms.uInk.value = cssColor('--text', '#1a1a1a');
        if (reduced) renderer.render(scene, camera);
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      resize();
      window.addEventListener('resize', resize, { passive: true });

      if (reduced) renderer.render(scene, camera); // 只出一帧，不动
      else start();
    }

    init();
  </script>
</BaseLayout>
