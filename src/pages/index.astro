---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const zhi = await getCollection('zhi');
const si = await getCollection('si');
const zhen = await getCollection('zhen');
const fu = await getCollection('fu');

const zhiPosts = zhi.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
const siPosts = si.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
const fuPosts = fu.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);

const zhenFeatured = zhen.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 1);
const zhenGrid = zhen.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 4);

const photoPlaceholders = [
  'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1200&h=675&fit=crop',
  'https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=600&h=450&fit=crop',
  'https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=600&h=450&fit=crop',
  'https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=600&h=450&fit=crop',
];

function slug(id: string) {
  return id.replace(/\.(md|mdx)$/, '');
}
---

<BaseLayout title="首页">
  <section class="hero reveal">
    <h1 class="hero-name">PESSIMIST11</h1>
    <p class="hero-tagline">记录技术、思想与旅途中的瞬间</p>
  </section>

  <div class="feature-photo reveal">
    <div class="feature-photo-inner">
      <img src={photoPlaceholders[0]} alt="" loading="lazy" />
    </div>
  </div>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">知</h2>
    </div>
    <ul class="magazine-list">
      {zhiPosts.map(post => (
        <li class="magazine-item">
          <a href={`/zhi/${slug(post.id)}/`}>
            <div class="magazine-date">
              {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">思</h2>
    </div>
    <ul class="magazine-list">
      {siPosts.map(post => (
        <li class="magazine-item">
          <a href={`/si/${slug(post.id)}/`}>
            <div class="magazine-date">
              {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">帧</h2>
    </div>
    <div class="photo-grid">
      {zhenGrid.length > 0 ? zhenGrid.map(post => (
        <a href={`/zhen/${slug(post.id)}/`} class="photo-grid-item">
          <img src={photoPlaceholders[zhenGrid.indexOf(post) + 1] || photoPlaceholders[0]} alt={post.data.title} loading="lazy" />
        </a>
      )) : photoPlaceholders.slice(1).map((url, i) => (
        <a href="/zhen/" class="photo-grid-item">
          <img src={url} alt={`旅行摄影 ${i + 1}`} loading="lazy" />
        </a>
      ))}
    </div>
  </section>

  <section class="home-section reveal">
    <div class="home-section-heading">
      <h2 class="home-section-zh">馥</h2>
    </div>
    <ul class="magazine-list">
      {fuPosts.map(post => (
        <li class="magazine-item">
          <a href={`/fu/${slug(post.id)}/`}>
            <div class="magazine-date">
              {post.data.pubDate.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', year: 'numeric' })}
            </div>
            <div class="magazine-content">
              <div class="magazine-title">{post.data.title}</div>
              {post.data.description && <div class="magazine-desc">{post.data.description}</div>}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
