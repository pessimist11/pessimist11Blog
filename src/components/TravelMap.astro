---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import worldmapSvg from '@/assets/worldmap.svg?raw';

interface Place {
  name: string;
  location?: string;
  date: string;
  frames: number;
  lat: number;
  lng: number;
  href: string;
  image?: ImageMetadata;
  description?: string;
  latest?: boolean;
}
interface Props { places: Place[]; }
const places = Astro.props.places.filter(p => Number.isFinite(p.lat) && Number.isFinite(p.lng) && Math.abs(p.lat) <= 90 && Math.abs(p.lng) <= 180);
const coordinate = (n: number, positive: string, negative: string) => `${Math.abs(n).toFixed(2)}° ${n >= 0 ? positive : negative}`;
const initialView = [1410, 210, 400, 300];
---

{places.length > 0 && (
  <section class="travel-atlas reveal" data-atlas data-mode="flat" aria-label="行旅地图">
    <div class="tm-heading">
      <span>行旅坐标 <span class="tm-heading-en">TRAVEL ATLAS</span></span>
      <span>{String(places.length).padStart(2, '0')} 辑风景</span>
    </div>

    <div class="tm-layout">
      <div class="tm-stories" aria-live="polite" aria-atomic="true">
        {places.map((place, i) => (
          <article class="tm-story" data-place-card={i} hidden={i !== 0}>
            <div class="tm-kicker">{place.latest ? '最近一程' : '行旅档案'}</div>
            <h2>{place.name}</h2>
            <p class="tm-coordinates">{coordinate(place.lat, 'N', 'S')} <span>／</span> {coordinate(place.lng, 'E', 'W')}</p>
            <a class="tm-photo" href={place.href} aria-label={`打开${place.name}相册`}>
              {place.image && <Image src={place.image} width={600} height={420} fit="cover" format="webp" alt={place.name} loading={i === 0 ? 'eager' : 'lazy'} />}
            </a>
            {place.description && <p class="tm-description">{place.description}</p>}
            <div class="tm-meta"><time datetime={place.date}>{place.date.replaceAll('-', '.')}</time><span>{place.frames} 帧</span></div>
            <a class="tm-album" href={place.href}>查看相册 <span aria-hidden="true">↗</span></a>
          </article>
        ))}
        <div class="tm-pagination tm-enhanced">
          <span class="tm-page"><span data-place-current>01</span> / {String(places.length).padStart(2, '0')}</span>
          <div>
            <button type="button" data-step="-1" aria-label="上一辑">←</button>
            <button type="button" data-step="1" aria-label="下一辑">→</button>
          </div>
        </div>
      </div>

      <div class="tm-map">
        <div class="tm-map-head tm-enhanced">
          <span class="tm-map-caption" data-map-caption>点选坐标，查看影集</span>
          <div class="tm-modes" role="group" aria-label="地图视图">
            <button type="button" data-mode-button="globe" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18M5 6.5h14M5 17.5h14"/></svg>地球</button>
            <button type="button" data-mode-button="flat" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 5 6-2 6 2 6-2v16l-6 2-6-2-6 2ZM9 3v16M15 5v16"/></svg>平面</button>
          </div>
        </div>

        <div class="tm-stage" tabindex="0" role="group" aria-label="行旅地图；方向键移动，加减键缩放，Home 复位">
          <canvas class="tm-globe" aria-hidden="true"></canvas>
          <div class="tm-flat" aria-hidden="true" set:html={worldmapSvg.replace('viewBox="0 0 2000 1000"', `viewBox="${initialView.join(' ')}" preserveAspectRatio="none"`)} />
          <div class="tm-pins">
            {places.map((place, i) => (
              <a class={`tm-pin${i === 0 ? ' is-active' : ''}`} data-place={i} data-lat={place.lat} data-lng={place.lng} href={place.href}
                style={`left:${(((place.lng + 180) / 360 * 2000 - initialView[0]) / initialView[2]) * 100}%;top:${(((90 - place.lat) / 180 * 1000 - initialView[1]) / initialView[3]) * 100}%`}
                aria-label={`预览${place.name}，${place.frames}帧`} aria-current={i === 0 ? 'true' : undefined}>
                <span class="tm-pin-dot" aria-hidden="true"></span><span class="tm-pin-label">{place.location || place.name}</span>
              </a>
            ))}
          </div>
          <span class="tm-north" aria-hidden="true">N<span>↑</span></span>
        </div>

        <div class="tm-map-foot tm-enhanced">
          <span class="tm-instruction"><span class="tm-desktop-hint">拖动探索 · Ctrl / ⌘ 滚动缩放</span><span class="tm-touch-hint">点选地点，查看这一程</span></span>
          <div class="tm-tools" role="group" aria-label="地图操作">
            <button type="button" class="tm-interact" data-interact aria-pressed="false">操作地图</button>
            <button type="button" data-map="in" aria-label="放大地图">＋</button>
            <button type="button" data-map="out" aria-label="缩小地图">−</button>
            <button type="button" data-map="reset" aria-label="查看全部足迹"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66M20 4v4h-4"/></svg></button>
          </div>
        </div>
      </div>
    </div>

    <nav class="tm-index" aria-label="选择行旅地点">
      {places.map((place, i) => <a href={place.href} data-place={i} class={i === 0 ? 'is-active' : ''} aria-current={i === 0 ? 'true' : undefined}><span>{String(i + 1).padStart(2, '0')}</span>{place.name}</a>)}
    </nav>
  </section>
)}

<script>
  import '@/lib/travel-atlas';
</script>

<style>
  .travel-atlas { --map-accent: #a95943; --map-land: #d5cec0; --map-line: #aaa291; margin: 32px 0 64px; }
  :global([data-theme='dark']) .travel-atlas { --map-accent: #d58b6f; --map-land: #313d40; --map-line: #617074; }
  .tm-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; border-top: 1px solid var(--list-divider); padding-top: 18px; margin-bottom: 30px; font-size: 12px; color: var(--list-text-muted); letter-spacing: .08em; }
  .tm-heading-en { margin-left: 16px; font-size: 10px; letter-spacing: .2em; opacity: .65; }
  .tm-layout { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); align-items: center; }
  .tm-stories { min-width: 0; }
  .tm-story[hidden] { display: none; }
  .tm-kicker { color: var(--map-accent); font-size: 11px; letter-spacing: .16em; margin-bottom: 6px; }
  .tm-story h2 { font-size: clamp(28px, 3vw, 38px); font-weight: 400; line-height: 1.5; letter-spacing: .04em; }
  .tm-coordinates { display: flex; gap: 8px; font-size: 12px; color: var(--list-text-muted); letter-spacing: .03em; margin: 8px 0 24px; font-variant-numeric: tabular-nums; }
  .tm-coordinates span { opacity: .35; }
  .tm-photo { display: block; overflow: hidden; aspect-ratio: 10 / 7; background: var(--bg-alt); }
  .tm-photo:hover, .tm-album:hover, .tm-index a:hover, .tm-pin:hover { transform: none; }
  .tm-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .tm-photo:hover img { transform: scale(1.025); }
  .tm-description { color: var(--list-text-muted); font-size: 14px; line-height: 1.8; margin-top: 18px; }
  .tm-meta { display: flex; gap: 18px; margin-top: 10px; font-size: 12px; color: var(--list-text-muted); font-variant-numeric: tabular-nums; }
  .tm-album { display: flex; align-items: center; justify-content: space-between; padding: 18px 0; font-size: 14px; color: var(--text); }
  .tm-album span { font-size: 21px; color: var(--map-accent); }
  .tm-pagination { border-top: 1px solid var(--list-divider); padding-top: 12px; display: flex; align-items: center; justify-content: space-between; color: var(--list-text-muted); }
  .tm-page { font-size: 12px; font-variant-numeric: tabular-nums; letter-spacing: .12em; }
  .travel-atlas button { font: inherit; color: inherit; background: transparent; border: 0; cursor: pointer; padding: 0; }
  .travel-atlas button:focus-visible, .tm-index a:focus-visible, .tm-album:focus-visible, .tm-photo:focus-visible { outline: 1px solid var(--map-accent); outline-offset: 4px; }
  .tm-pagination button { width: 36px; height: 32px; font-size: 19px; }
  .tm-pagination button:hover { color: var(--map-accent); }
  .tm-map { min-width: 0; align-self: stretch; display: flex; flex-direction: column; }
  .tm-map-head, .tm-map-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 38px; }
  .tm-map-caption { color: var(--list-text-muted); font-size: 11px; letter-spacing: .06em; }
  .tm-modes { display: flex; gap: 20px; flex-shrink: 0; }
  .tm-modes button { display: flex; gap: 6px; align-items: center; font-size: 12px; color: var(--list-text-muted); padding: 6px 0; border-bottom: 1px solid transparent; }
  .tm-modes button[aria-pressed='true'] { border-color: var(--map-accent); color: var(--text); }
  .tm-modes button:disabled { opacity: .35; cursor: default; }
  .tm-modes svg, .tm-tools svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .tm-stage { position: relative; isolation: isolate; flex: 1; min-height: 420px; overflow: hidden; touch-action: pan-y; cursor: grab; user-select: none; }
  .tm-stage[data-interactive='true'] { touch-action: none; }
  .tm-stage.is-grabbing { cursor: grabbing; }
  .tm-stage:focus-visible { outline: 1px solid var(--list-divider); outline-offset: 2px; }
  .tm-globe, .tm-flat, .tm-pins { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tm-globe { display: none; }
  .tm-flat { pointer-events: none; background: var(--bg-alt); border-radius: 3px; }
  .travel-atlas[data-mode='globe'] .tm-globe { display: block; }
  .travel-atlas[data-mode='globe'] .tm-flat { display: none; }
  .tm-flat :global(svg) { display: block; width: 100%; height: 100%; }
  .tm-flat :global(.worldmap-land) { fill: var(--map-land); stroke: var(--map-line); stroke-width: .35; vector-effect: non-scaling-stroke; }
  .tm-flat :global(.worldmap-grid) { fill: none; stroke: var(--map-line); stroke-width: .5; opacity: .18; vector-effect: non-scaling-stroke; }
  .tm-flat :global(.worldmap-borders) { fill: none; stroke: var(--map-line); stroke-width: .5; opacity: .45; vector-effect: non-scaling-stroke; }
  .tm-flat :global(.worldmap-rivers) { fill: none; stroke: var(--bg-alt); stroke-width: .65; opacity: .65; vector-effect: non-scaling-stroke; }
  .tm-flat :global(.worldmap-lakes) { fill: var(--bg-alt); }
  .tm-pins { pointer-events: none; }
  .tm-pin { position: absolute; width: 22px; height: 22px; margin: -11px 0 0 -11px; display: grid; place-items: center; pointer-events: auto; z-index: 1; transition: none; }
  .tm-pin[hidden] { display: none; }
  .tm-pin-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--map-accent); box-shadow: 0 0 0 2px var(--bg); transition: box-shadow .2s; }
  .tm-pin.is-active { z-index: 4; }
  .tm-pin.is-active .tm-pin-dot, .tm-pin:hover .tm-pin-dot, .tm-pin:focus-visible .tm-pin-dot { box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px var(--map-accent), 0 0 0 7px color-mix(in srgb, var(--map-accent) 12%, transparent); }
  .tm-pin:focus-visible { outline: none; z-index: 5; }
  .tm-pin-label { position: absolute; left: 50%; top: 50%; transform: translate(var(--label-x, 14px), var(--label-y, -50%)); font-size: 11px; white-space: nowrap; line-height: 1.5; color: var(--text); text-shadow: 0 1px 3px var(--bg), 0 -1px 3px var(--bg), 1px 0 3px var(--bg), -1px 0 3px var(--bg); }
  .tm-pin.is-label-hidden .tm-pin-label { visibility: hidden; }
  .tm-pin.is-label-hidden:hover .tm-pin-label, .tm-pin.is-label-hidden:focus-visible .tm-pin-label { visibility: visible; }
  .tm-north { position: absolute; top: 20px; left: 18px; display: flex; align-items: center; flex-direction: column; font-size: 10px; line-height: 1.5; color: var(--list-text-muted); pointer-events: none; opacity: .65; }
  .tm-north span { font-size: 24px; font-weight: 400; }
  .tm-map-foot { padding-top: 8px; }
  .tm-instruction { font-size: 11px; letter-spacing: .02em; color: var(--list-text-muted); }
  .tm-tools { display: flex; gap: 4px; }
  .tm-tools button { display: grid; place-items: center; width: 34px; height: 34px; font-size: 18px; color: var(--list-text-muted); }
  .tm-tools button:hover { color: var(--map-accent); }
  .tm-tools button:disabled { opacity: .3; cursor: default; }
  .tm-tools .tm-interact { display: none; width: auto; padding: 0 10px; font-size: 11px; }
  .tm-touch-hint { display: none; }
  .tm-index { position: static; height: auto; display: flex; flex-wrap: wrap; gap: 8px 30px; background: transparent; margin-top: 30px; padding: 18px 0; border: 0; border-top: 1px solid var(--list-divider); z-index: auto; }
  .tm-index a { display: flex; align-items: baseline; gap: 8px; padding: 5px 0 8px; font-size: 13px; color: var(--list-text-muted); border-bottom: 1px solid transparent; white-space: nowrap; }
  .tm-index a span { font-size: 10px; opacity: .55; font-variant-numeric: tabular-nums; }
  .tm-index a.is-active { color: var(--text); border-color: var(--map-accent); }
  .travel-atlas:not([data-bound]) .tm-enhanced { visibility: hidden; }
  @media (hover: none) and (pointer: coarse) {
    .tm-tools .tm-interact { display: grid; }
    .tm-interact[aria-pressed='true'] { color: var(--map-accent); }
    .tm-touch-hint { display: inline; }
    .tm-desktop-hint { display: none; }
  }
  @media (max-width: 760px) {
    .tm-layout { grid-template-columns: 1fr; gap: 24px; }
    .tm-map { grid-row: 1; }
    .tm-stage { min-height: 340px; height: 340px; flex: auto; }
    .tm-map-caption { display: none; }
    .tm-map-head { justify-content: flex-end; }
    .tm-stories { padding-top: 24px; border-top: 1px solid var(--list-divider); }
    .tm-story { display: grid; grid-template-columns: minmax(0, 1fr) 42%; column-gap: 20px; align-content: start; }
    .tm-kicker, .tm-story h2, .tm-coordinates, .tm-description, .tm-meta { grid-column: 1; }
    .tm-story h2 { font-size: 26px; }
    .tm-photo { grid-column: 2; grid-row: 1 / 7; height: 100%; min-height: 160px; aspect-ratio: auto; }
    .tm-coordinates { flex-wrap: wrap; gap: 0 5px; font-size: 11px; margin: 6px 0 0; }
    .tm-description { font-size: 13px; margin-top: 12px; }
    .tm-meta { flex-wrap: wrap; gap: 0 10px; margin-top: 8px; font-size: 11px; }
    .tm-album { grid-column: 1 / -1; padding: 18px 0 12px; }
    .tm-index { gap: 6px 22px; margin-top: 22px; }
    .tm-heading { margin-bottom: 8px; }
    .tm-heading-en { margin-left: 8px; font-size: 9px; }
    .travel-atlas { margin-bottom: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tm-photo img, .tm-pin-dot { transition: none; }
  }
</style>
