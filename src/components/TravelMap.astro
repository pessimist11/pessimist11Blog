---
interface Place {
  name: string;
  location?: string;
  year: number;
  frames: number;
  lat: number;
  lng: number;
  href: string;
  latest?: boolean;
}

interface Props {
  places: Place[];
}

const { places } = Astro.props;
import worldmapSvg from '@/assets/worldmap.svg?raw';

const W = 2000;
const H = 1000;

// 等距圆柱投影：经纬度 → SVG 坐标
const pins = places
  .filter(p => typeof p.lat === 'number' && typeof p.lng === 'number')
  .sort((a, b) => b.frames - a.frames)
  .map(p => ({
    ...p,
    sx: ((p.lng + 180) / 360) * W,
    sy: ((90 - p.lat) / 180) * H,
  }));

// 海洋名称：和陆地一样按等距圆柱投影算坐标，但交给页面上的元素定位，不写进 SVG ——
// build-fonts.mjs 只扫描 src 下的文本文件，.svg 不在扫描范围内，写进去这些字会缺字形变豆腐块。
// 坐标要落在「会出现的视野里」才有意义：默认视野只框住西太平洋，所以只有太平洋会露出来，
// 其余三个在往西/往南/往北拖的时候才出现。
const OCEANS = [
  { name: '太平洋', lng: 142, lat: 24 },
  { name: '大西洋', lng: -35, lat: 22 },
  { name: '印度洋', lng: 78, lat: -25 },
  { name: '北冰洋', lng: 40, lat: 80 },
];
const oceans = OCEANS.map(o => ({
  ...o,
  sx: ((o.lng + 180) / 360) * W,
  sy: ((90 - o.lat) / 180) * H,
}));

// 初始视野：以中国为中心、宽度固定。高度不写死 —— 由容器比例在运行时算（见组件脚本），
// 否则窗口比例和容器对不上时 SVG 会等比留白。
const viewBox = '1360 160 480 240';
---

<figure class="travel-map reveal" data-viewbox={viewBox} aria-label="去过的地方地图">
  <div class="tm-view tm-view--flat">
    <div class="tm-canvas" aria-hidden="false">
      {pins.map(pin => (
        <a
          class={`tm-pin${pin.latest ? ' tm-pin--latest' : ''}`}
          href={pin.href}
          data-svgx={pin.sx}
          data-svgy={pin.sy}
          data-frames={pin.frames}
          aria-label={`${pin.name} ${pin.year}`}
        >
          <span class="tm-pin-dot" aria-hidden="true"></span>
          <span class="tm-label">{pin.name}</span>
        </a>
      ))}
    </div>
    <div class="tm-svg" set:html={worldmapSvg}></div>
    <div class="tm-oceans" aria-hidden="true">
      {oceans.map(o => (
        <span class="tm-ocean" data-svgx={o.sx} data-svgy={o.sy}>{o.name}</span>
      ))}
    </div>
  </div>
  <div class="tm-tools" role="group" aria-label="地图缩放">
    <button type="button" class="tm-tool" data-map="in" aria-label="放大">＋</button>
    <button type="button" class="tm-tool" data-map="out" aria-label="缩小">－</button>
    <button type="button" class="tm-tool" data-map="reset" aria-label="恢复默认视野">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66M20 4v4h-4" /></svg>
    </button>
  </div>
  <div class="tm-hint" role="status">按住 Ctrl / ⌘ 滚动缩放 · 双击放大 · 拖拽平移</div>
</figure>

<script>
  let live: { figure: HTMLElement; dispose: () => void } | null = null;

  function teardown() {
    live?.dispose();
    live = null;
  }

  // 模块脚本只执行一次；每次切页后都要为新的地图 DOM 初始化。
  function boot() {
    const figure = document.querySelector<HTMLElement>('.travel-map');
    if (live?.figure === figure) return;
    teardown();
    if (!figure) return;

    const controller = new AbortController();
    const { signal } = controller;
    figure.dataset.bound = '1';
    const canvas = figure.querySelector('.tm-canvas');
    const svg = figure.querySelector('.tm-svg svg');
    const pins = [...figure.querySelectorAll('.tm-pin')]
      .map(el => ({
        el,
        label: el.querySelector('.tm-label'),
        sx: parseFloat(el.dataset.svgx || '0'),
        sy: parseFloat(el.dataset.svgy || '0'),
        frames: parseInt(el.dataset.frames || '0', 10),
      }))
      .sort((a, b) => b.frames - a.frames);
    const oceans = [...figure.querySelectorAll('.tm-ocean')].map(el => ({
      el,
      sx: parseFloat(el.dataset.svgx || '0'),
      sy: parseFloat(el.dataset.svgy || '0'),
    }));
    const toolIn = figure.querySelector('[data-map="in"]');
    const toolOut = figure.querySelector('[data-map="out"]');

    const WORLD_W = 2000;
    const WORLD_H = 1000;
    // data-viewbox 只用它的中心和宽度；高度交给容器比例决定
    const BASE = (figure.dataset.viewbox || '1360 160 480 240').split(' ').map(Number);
    const BASE_W = BASE[2] || 480;
    const BASE_CENTER = { x: BASE[0] + BASE_W / 2, y: BASE[1] + (BASE[3] || BASE_W / 2) / 2 };

    // 默认视野的高度跟着容器比例走。窗口比例与容器不一致时 SVG 会等比留白：
    // 2:1 的窗口塞进 2.35:1 的桌面容器，左右各空约 80px；塞进更方的移动端容器，上下空得更多。
    function baseViewFromBox() {
      const rect = figure.getBoundingClientRect();
      const box = rect.height > 0 ? rect.width / rect.height : 2;
      const h = BASE_W / clamp(box || 2, 0.9, 3.4);
      return [BASE_CENTER.x - BASE_W / 2, BASE_CENTER.y - h / 2, BASE_W, h];
    }

    let baseView = baseViewFromBox();
    let moved = false; // 用户自己缩放过：换视口时不要把他的视野重置掉
    let vb = [...baseView];
    // 最大缩放 10×（原为 14×）：这张图是 1:50m 数据，14× 相当于把 1:50M 的图放到约 1:2M 看，
    // 海岸线就只剩一条条直线段了。10× 仍在「放大细看」的范围里，但棱角感明显收敛。
    const minZoomW = BASE_W / 10;
    let aspect = baseView[3] / baseView[2];

    function clamp(v, lo, hi) {
      return Math.min(hi, Math.max(lo, v));
    }

    // 到底了就把对应按钮置灰，省得用户对着没反应的按钮点
    function updateTools() {
      if (toolIn) toolIn.disabled = vb[2] <= minZoomW * 1.02;
      if (toolOut) toolOut.disabled = vb[2] >= WORLD_W * 0.999;
    }

    let labelsTimer = null;

    function positionPins() {
      if (svg) svg.setAttribute('viewBox', vb.join(' '));
      for (const pin of pins) {
        const px = ((pin.sx - vb[0]) / vb[2]) * 100;
        const py = ((pin.sy - vb[1]) / vb[3]) * 100;
        const show = px >= -4 && px <= 104 && py >= -4 && py <= 104;
        pin.el.style.display = show ? '' : 'none';
        if (!show) {
          pin.el.classList.add('is-label-hidden');
          continue;
        }
        pin.el.style.left = px.toFixed(2) + '%';
        pin.el.style.top = py.toFixed(2) + '%';
      }
      // 海洋名称跟着地图走；留一点边距，别让字半个挂在盒子外
      for (const ocean of oceans) {
        const px = ((ocean.sx - vb[0]) / vb[2]) * 100;
        const py = ((ocean.sy - vb[1]) / vb[3]) * 100;
        const show = px >= 2 && px <= 98 && py >= 2 && py <= 98;
        ocean.el.style.display = show ? '' : 'none';
        if (show) {
          ocean.el.style.left = px.toFixed(2) + '%';
          ocean.el.style.top = py.toFixed(2) + '%';
        }
      }
      updateTools();
    }

    function updateLabels() {
      const visible = pins.filter(p => p.el.style.display !== 'none');
      // 标签碰撞检测：先试默认位置（图钉下方），被压住就翻到上方，两边都压住才藏起来。
      // 藏起来的标签鼠标移上去／键盘聚焦时会露出来（见样式），所以每个地点始终够得着名字。
      const placed = [];
      for (const pin of visible) {
        let ok = false;
        for (const above of [false, true]) {
          pin.el.classList.toggle('is-label-above', above);
          const rect = pin.label.getBoundingClientRect();
          const hit = placed.some(r =>
            !(rect.right < r.left - 4 || rect.left > r.right + 4 || rect.bottom < r.top - 2 || rect.top > r.bottom + 2)
          );
          if (!hit) {
            placed.push({ left: rect.left, right: rect.right, top: rect.top, bottom: rect.bottom });
            ok = true;
            break;
          }
        }
        pin.el.classList.toggle('is-label-hidden', !ok);
      }
    }

    function layout() {
      positionPins();
      updateLabels();
    }

    // 拖拽时同步更新位置（图钉与地图同一帧渲染，标记点不会相对地图漂移）；
    // 标签碰撞检测延后执行，避免拖拽卡顿
    function scheduleLabels() {
      clearTimeout(labelsTimer);
      labelsTimer = setTimeout(updateLabels, 120);
    }

    function clampViewBox() {
      vb[2] = clamp(vb[2], minZoomW, WORLD_W);
      vb[3] = vb[2] * aspect;
      vb[0] = clamp(vb[0], 0, WORLD_W - vb[2]);
      vb[1] = clamp(vb[1], 0, WORLD_H - vb[3]);
    }

    function zoomAt(clientX, clientY, factor) {
      moved = true;
      const rect = canvas.getBoundingClientRect();
      const px = clientX - rect.left;
      const py = clientY - rect.top;
      const fx = vb[0] + (px / rect.width) * vb[2];
      const fy = vb[1] + (py / rect.height) * vb[3];
      vb[2] = clamp(vb[2] / factor, minZoomW, WORLD_W);
      vb[3] = vb[2] * aspect;
      vb[0] = fx - (px / rect.width) * vb[2];
      vb[1] = fy - (py / rect.height) * vb[3];
      clampViewBox();
      positionPins();
      scheduleLabels();
    }

    // Ctrl/Cmd + 滚轮缩放，否则提示
    let hintTimer;
    figure.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey && !e.metaKey) {
          figure.classList.add('is-hint');
          clearTimeout(hintTimer);
          hintTimer = setTimeout(() => figure.classList.remove('is-hint'), 1200);
          return;
        }
        e.preventDefault();
        zoomAt(e.clientX, e.clientY, Math.exp(-e.deltaY * 0.0016));
      },
      { passive: false, signal }
    );

    // 双击放大 / 复位
    figure.addEventListener('dblclick', (e) => {
      if (vb[2] <= minZoomW * 1.05) {
        vb = [...baseView];
        moved = false;
        layout();
      } else {
        zoomAt(e.clientX, e.clientY, 2);
      }
    }, { signal });

    // 右下角的 ＋ / － / ↺：滚轮缩放必须按住 Ctrl 才生效，光靠它太不好发现
    figure.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-map]');
      if (!btn) return;
      const rect = canvas.getBoundingClientRect();
      const midX = rect.left + rect.width / 2;
      const midY = rect.top + rect.height / 2;
      if (btn.dataset.map === 'in') zoomAt(midX, midY, 1.6);
      else if (btn.dataset.map === 'out') zoomAt(midX, midY, 1 / 1.6);
      else {
        baseView = baseViewFromBox();
        aspect = baseView[3] / baseView[2];
        vb = [...baseView];
        moved = false;
        layout();
      }
    }, { signal });

    // 拖拽平移 + 双指捏合缩放
    const pointers = new Map();
    let lastDist = 0;
    let dragged = false;

    canvas.addEventListener('pointerdown', (e) => {
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      dragged = false;
      if (pointers.size === 1) canvas.classList.add('is-grab');
    }, { signal });

    canvas.addEventListener('pointermove', (e) => {
      if (!pointers.has(e.pointerId)) return;
      const prev = pointers.get(e.pointerId);
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      const list = [...pointers.values()];
      const rect = canvas.getBoundingClientRect();

      if (list.length >= 2) {
        const dist = Math.hypot(list[0].x - list[1].x, list[0].y - list[1].y);
        if (lastDist) {
          const midX = (list[0].x + list[1].x) / 2;
          const midY = (list[0].y + list[1].y) / 2;
          zoomAt(midX, midY, dist / lastDist);
        }
        lastDist = dist;
        dragged = true;
      } else {
        const dx = e.clientX - prev.x;
        const dy = e.clientY - prev.y;
        if (Math.hypot(dx, dy) > 4) {
          dragged = true;
          moved = true;
        }
        vb[0] -= (dx / rect.width) * vb[2];
        vb[1] -= (dy / rect.height) * vb[3];
        clampViewBox();
        positionPins();
      }
    }, { signal });

    function endPointer(e) {
      pointers.delete(e.pointerId);
      if (pointers.size < 2) lastDist = 0;
      if (pointers.size === 0) {
        canvas.classList.remove('is-grab');
        updateLabels();
      }
    }
    canvas.addEventListener('pointerup', endPointer, { signal });
    canvas.addEventListener('pointercancel', endPointer, { signal });
    canvas.addEventListener('pointerleave', (e) => {
      if (pointers.size === 1) pointers.delete(e.pointerId);
    }, { signal });

    // 拖拽后抑制图钉跳转
    canvas.addEventListener('click', (e) => {
      if (dragged) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, { signal });

    // 换视口：重算默认视野比例；用户没手动缩放过就跟着复位，缩放过则只修高度
    function onResize() {
      baseView = baseViewFromBox();
      aspect = baseView[3] / baseView[2];
      if (!moved) vb = [...baseView];
      else {
        vb[3] = vb[2] * aspect;
        clampViewBox();
      }
      layout();
    }
    window.addEventListener('resize', onResize, { passive: true, signal });
    layout();

    live = {
      figure,
      dispose() {
        controller.abort();
        clearTimeout(labelsTimer);
        clearTimeout(hintTimer);
        pointers.clear();
        canvas.classList.remove('is-grab');
        figure.classList.remove('is-hint');
        delete figure.dataset.bound;
      },
    };
  }

  document.addEventListener('astro:before-swap', teardown);
  document.addEventListener('astro:page-load', boot);
  boot(); // 兼顾首次加载，幂等检查避免重复绑定。
</script>

<style>
  .travel-map {
    position: relative;
    z-index: 0;
    width: 100%;
    height: 460px;
    margin-bottom: 48px;
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
    background: var(--bg);
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .tm-view {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .tm-canvas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 2;
  }
  .tm-canvas.is-grab {
    cursor: grabbing;
  }
  .tm-svg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .tm-svg :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .tm-svg :global(.worldmap-land) {
    fill: var(--border-strong);
    stroke: none;
    opacity: 0.65;
  }
  .tm-svg :global(.worldmap-grid) {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 0.6;
    opacity: 0.45;
    /* 缩放靠改 viewBox，描边会跟着变粗；non-scaling-stroke 让线宽固定为屏幕像素 */
    vector-effect: non-scaling-stroke;
  }
  /* 国界：一根很淡的发丝线。用 --text 混一点透明，亮色下是淡墨、暗色下是浅灰，
     两种主题都成立；non-scaling-stroke 保证放大到 14× 也不会变粗成一坨。 */
  .tm-svg :global(.worldmap-borders) {
    fill: none;
    stroke: var(--text);
    stroke-width: 0.35;
    opacity: 0.17;
    vector-effect: non-scaling-stroke;
  }
  /* 河流：比国界更淡更细一档，只作为陆地上的纹理，不抢图钉 */
  .tm-svg :global(.worldmap-rivers) {
    fill: none;
    stroke: var(--text);
    stroke-width: 0.3;
    opacity: 0.13;
    vector-effect: non-scaling-stroke;
  }
  /* 湖面用页面底色填，看起来就是把陆地挖开；深浅色主题都成立 */
  .tm-svg :global(.worldmap-lakes) {
    fill: var(--bg);
    stroke: var(--border-strong);
    stroke-width: 0.4;
    opacity: 0.9;
    vector-effect: non-scaling-stroke;
  }
  /* 海洋名称：跟着地图平移缩放，不可点 */
  .tm-oceans {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }
  .tm-ocean {
    position: absolute;
    transform: translate(-50%, -50%);
    font-size: 9px;
    letter-spacing: 0.35em;
    text-indent: 0.35em;
    color: var(--text-faint);
    opacity: 0.8;
    white-space: nowrap;
  }
  /* 缩放按钮 */
  .tm-tools {
    position: absolute;
    right: 6px;
    bottom: 6px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .tm-tool {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .tm-tool:hover:not(:disabled) {
    color: var(--text);
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }
  .tm-tool:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .tm-tool svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tm-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--text);
    text-decoration: none;
  }
  .tm-pin-dot {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #c0392b;
    border: 2.5px solid var(--bg);
    box-shadow: 0 0 0 3px color-mix(in srgb, #c0392b 28%, transparent);
  }
  .tm-pin--latest .tm-pin-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid #c0392b;
    animation: tm-breathe 2.2s ease-out infinite;
    pointer-events: none;
  }
  @keyframes tm-breathe {
    0% {
      transform: scale(0.8);
      opacity: 1;
    }
    70% {
      transform: scale(2.4);
      opacity: 0;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tm-pin--latest .tm-pin-dot::after {
      animation: none;
    }
  }
  .tm-label {
    margin-top: 6px;
    font-size: 12px;
    line-height: 1.2;
    color: var(--text);
    white-space: nowrap;
    text-shadow: 0 1px 2px var(--bg);
  }
  /* 被挤到图钉上方的标签 */
  .tm-pin.is-label-above .tm-label {
    order: -1;
    margin-top: 0;
    margin-bottom: 6px;
  }
  /* 碰撞检测判定会互相压住的标签先藏起来，指到／聚焦时再露出来 —— 不这样的话
     像青岛这种和「泰安＆淄博」挨得近的地点，名字就永远看不到了 */
  .tm-pin.is-label-hidden .tm-label {
    opacity: 0;
  }
  .tm-pin.is-label-hidden:hover .tm-label,
  .tm-pin.is-label-hidden:focus-visible .tm-label {
    opacity: 1;
  }
  .tm-hint {
    position: absolute;
    left: 50%;
    bottom: 12px;
    transform: translateX(-50%);
    z-index: 3;
    font-size: 12px;
    color: var(--text-muted);
    background: var(--surface);
    padding: 4px 10px;
    border-radius: 999px;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
    white-space: nowrap;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
  }
  .travel-map.is-hint .tm-hint {
    opacity: 1;
  }
  @media (max-width: 768px) {
    .travel-map {
      width: 100%;
      height: 320px;
    }
  }
</style>
