---
interface Props {
  title: string;
  musicUrl: string;
  embedUrl?: string;
}
const { title, musicUrl, embedUrl } = Astro.props;
---

<div class="music-player" data-music-player data-src={embedUrl} data-title={title}>
  <div class="player-actions">
    {embedUrl && <button type="button" data-player-toggle hidden aria-expanded="false">▷ 试听</button>}
    <a href={musicUrl} target="_blank" rel="noopener noreferrer">在 Apple Music 打开 ↗</a>
  </div>
  {embedUrl && <>
    <div class="player-slot" data-player-slot hidden></div>
    <p class="player-status" data-player-status role="status"></p>
    <p class="player-note">试听与完整播放以平台提供为准。</p>
  </>}
</div>

<style>
  .player-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 20px; }
  button { font: inherit; color: var(--text); background: none; border: 1px solid var(--border); padding: 8px 16px; cursor: pointer; }
  button:hover { border-color: var(--text-muted); }
  a { color: var(--text-muted); font-size: 14px; }
  a:hover { color: var(--text); }
  .player-slot { margin-top: 20px; }
  .player-slot :global(iframe) { display: block; width: 100%; height: 175px; border: 0; border-radius: 10px; }
  .player-note, .player-status { font-size: 12px; color: var(--text-muted); margin: 8px 0 0; }
  .player-status:empty { display: none; }
  [hidden] { display: none; }
</style>

<script>
  let dispose: (() => void) | undefined;

  function bootPlayers() {
    dispose?.();
    const controller = new AbortController();
    const resets: (() => void)[] = [];
    document.querySelectorAll<HTMLElement>('[data-music-player]').forEach(root => {
      const button = root.querySelector<HTMLButtonElement>('[data-player-toggle]');
      const slot = root.querySelector<HTMLElement>('[data-player-slot]');
      const status = root.querySelector<HTMLElement>('[data-player-status]');
      if (!button || !slot || !status || !root.dataset.src) return;
      let frame: HTMLIFrameElement | undefined;
      let timeout: ReturnType<typeof setTimeout> | undefined;
      const reset = () => {
        clearTimeout(timeout);
        frame?.remove();
        frame = undefined;
        slot.hidden = true;
        status.textContent = '';
        button.textContent = '▷ 试听';
        button.setAttribute('aria-expanded', 'false');
      };
      resets.push(reset);
      button.hidden = false;
      button.addEventListener('click', () => {
        if (frame) { reset(); return; }
        resets.forEach(close => close());
        const next = document.createElement('iframe');
        frame = next;
        next.src = root.dataset.src!;
        next.title = `${root.dataset.title} · Apple Music 播放器`;
        next.allow = 'autoplay; encrypted-media; fullscreen';
        next.setAttribute('sandbox', 'allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation');
        next.addEventListener('load', () => {
          if (frame !== next) return;
          clearTimeout(timeout);
          status.textContent = '若播放器未显示，请使用上方平台链接。';
        }, { signal: controller.signal, once: true });
        slot.hidden = false;
        slot.append(next);
        button.textContent = '关闭播放器';
        button.setAttribute('aria-expanded', 'true');
        status.textContent = '正在加载 Apple Music…';
        timeout = setTimeout(() => {
          status.textContent = '加载较慢，可以使用上方平台链接继续收听。';
        }, 12000);
      }, { signal: controller.signal });
    });
    dispose = () => {
      controller.abort();
      resets.forEach(reset => reset());
    };
  }
  document.addEventListener('astro:page-load', bootPlayers);
  document.addEventListener('astro:before-swap', () => { dispose?.(); dispose = undefined; });
  bootPlayers();
</script>
